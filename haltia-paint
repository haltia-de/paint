        if not pictures and not waiting and not failed:
            content.pack_start(Gtk.Label(label="Нет картин"), True, True, 0)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_kinetic_scrolling(True)
        scroll.add(content)
