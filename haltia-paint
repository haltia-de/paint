    def load_large(self, item):
        try:
            url, licence = image_info([item["file"]], LARGE)[item["file"]]
            data = fetch_image(url)
            pb = pixbuf_of(data, 640, 520)
        except Exception as exc:
            sys.stderr.write("haltia-paint: %s: %s\n" % (item["file"], exc))
            data = pb = licence = None
        GLib.idle_add(self.preview_loaded, item, data, pb, licence)

    def preview_loaded(self, item, data, pb, licence):
        if data is None:
            item["failed"] = True
        else:
            item.update(data=data, large=pb, licence=licence)
        if item is self.preview_item:
            if data is not None:
                self.convert_grades(item)
            self.choose_grade(self.grade)
        return False

    def kind(self):
        """What the preview is to show: (level, big numbers, outlines)."""
        return (self.grade[0], self.big_numbers, self.ink)

    def toggle_big(self):
        self.big_numbers = not self.big_numbers
        self.choose_grade(self.grade)

    def set_ink(self, level):
        self.ink = level
        self.choose_grade(self.grade)

    def convert_grades(self, item):
        """Make the picture of the chosen kind, before any other work (the
        person waits for it); each kind shows as it is ready."""
        kind = self.kind()
        jobs = item.setdefault("jobs", {})
        if kind in item["pics"] or kind in jobs:
            return
        out = os.path.join(WORK, "%s-%s.svgz" % (item["qid"], kind_name(kind)))
        meta = {"name": item["title"], "theme": item.get("theme", sections.OTHER),
                "author": item["author"], "level": 8,
                "source": item["file"], "wikidata": item["qid"]}
        item.setdefault("progress", {})[kind] = 0
        jobs[kind] = self.conversion.submit(
            item["data"], out, kind[0], meta, urgent=True, flags=kind_flags(kind),
            on_progress=lambda _job, share: self.grade_progress(item, kind, share),
            on_done=lambda _job, ok: self.grade_made(item, kind, out, ok))

    def grade_progress(self, item, kind, share):
        item["progress"][kind] = share
        if item is self.preview_item and kind == self.kind():
            self.view_progress.set_fraction(share)

    def grade_made(self, item, kind, out, ok):
        """A kind made: drawn small in a thread, then shown; None in
        item["pics"] when it could not be made."""
        def work():
            pic = picture_at(out, "preview") if ok else None
            if pic:
                pic["image"] = whole_picture(
                    pic, 640, 520, lambda i, p=pic: hex_rgb(p["palette"][p["regions"][i].n]),
                    lambda i: True, ink=INK_PREVIEW)
                drop_regions(pic)
            GLib.idle_add(made, pic)

        def made(pic):
            item["jobs"].pop(kind, None)
            item["pics"][kind] = pic
            if item is self.preview_item and kind == self.kind():
                self.choose_grade(self.grade)
            return False

        self.pool.submit(work)

    def leave_preview(self):
        """The preview is left: the sizes still being made are not wanted."""
        self.photo_request = None
        item = self.preview_item
        if item:
            for job in item.get("jobs", {}).values():
                job.cancel()
            item["jobs"] = {}

    def pick_grade(self, grade):
        """A size tapped: one that could not be made is tried again."""
        kind = (grade[0], self.big_numbers, self.ink)
        if self.preview_item["pics"].get(kind, ()) is None:
            del self.preview_item["pics"][kind]
        self.choose_grade(grade)

    def draw_preview(self, widget, cr):
        item = self.preview_item
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        pic = item["pics"].get(self.kind()) if item else None
        if pic and not self.show_original:
            image = pic["image"]
            cr.set_source_surface(image, (w - image.get_width()) // 2,
                                  (h - image.get_height()) // 2)
            cr.paint()
            return False
        pb = item.get("large") or item.get("small") if item else None
        if pb:
            scale = min(w / pb.get_width(), h / pb.get_height())
            cr.translate((w - pb.get_width() * scale) / 2, (h - pb.get_height() * scale) / 2)
            cr.scale(scale, scale)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
        return False

    def flip_preview(self):
        if self.preview_item and self.kind() in self.preview_item["pics"]:
            self.show_original = not self.show_original
            self.choose_grade(self.grade)
        return False

    def choose_grade(self, grade):
        self.grade = grade
        item = self.preview_item
        for b, on in ([(b, g == grade) for b, g in self.grade_buttons]
                      + [(b, v == self.ink) for b, v in self.ink_buttons]
                      + [(self.big_button, self.big_numbers)]):
            (b.get_style_context().add_class if on else b.get_style_context().remove_class)("on")
        kind = self.kind()
        if kind not in item["pics"]:
            self.show_original = False
            if "data" in item:
                self.convert_grades(item)
        pic = item["pics"].get(kind)
        have = os.path.exists(downloaded_path(item["qid"], kind))
        if item.get("licence"):
            free = item["licence"].lower() in ("public domain", "cc0", "pd")
            self.licence_label.set_text("Общественное достояние" if free
                                        else "Лицензия: " + item["licence"])
        if item.get("failed"):
            self.view_note.set_text("Не удалось загрузить картину")
        elif "data" not in item:
            self.view_note.set_text("Загружаю картину…")
        elif kind not in item["pics"]:
            self.view_note.set_text("Готовлю картину, это около полуминуты…")
        elif pic is None:
            self.view_note.set_text("Не получилось сделать картину. "
                                    "Нажмите размер, чтобы попробовать ещё раз")
        elif self.show_original:
            self.view_note.set_text("Картина. Нажмите, чтобы увидеть раскраску")
        else:
            self.view_note.set_text("Так будет в раскраске. Нажмите, чтобы увидеть картину")
        if have:
            self.preview_note.set_text("Уже в раскрасках")
        elif pic:
            self.preview_note.set_text("%s, %s" % (
                sections.regions(pic["count"]),
                sections.plural(len(pic["palette"]), "цвет", "цвета", "цветов")))
        else:
            self.preview_note.set_text("")
        making = "data" in item and kind not in item["pics"]
        self.view_progress.set_fraction(item.get("progress", {}).get(kind, 0))
        self.view_progress.set_visible(making)
        self.get_button.set_sensitive(bool(have or pic))
        self.view.queue_draw()

    def choose_theme(self):
        item = self.preview_item
        names = [n for n in sections.THEMES if n != sections.MY_PHOTOS]
        k = dialogs.choose(self.win, "Тема картины", names,
                           names.index(item["theme"]) if item["theme"] in names else None)
        if k is not None:
            item["theme"] = names[k]
            self.theme_button.set_label("Тема: " + item["theme"])
            set_themes({item["qid"]: item["theme"]})
            self.gallery_stale = True

    def get_picture(self):
        """Take the picture of the chosen kind into the gallery (Загруженные
        there, own pictures among Мои фотографии) and open it."""
        item, kind = self.preview_item, self.kind()
        pic_id = "wd-%s-%s" % (item["qid"], kind_name(kind))
        path = downloaded_path(item["qid"], kind)
        if not os.path.exists(path):
            try:
                os.makedirs(DOWNLOADED, exist_ok=True)
                shutil.copyfile(item["pics"][kind]["path"], path + ".new")
                os.replace(path + ".new", path)
            except OSError as exc:
                sys.stderr.write("haltia-paint: %s: %s\n" % (path, exc))
                self.preview_note.set_text("Не удалось сохранить")
                return
            if not item.get("own"):
                set_themes({item["qid"]: item["theme"]})
            # The painting itself beside it, for «Оригинал» at its end.
            original = downloaded_original(item["qid"])
            if not os.path.exists(original):
                def save_original():
                    try:
                        pixbuf_of(item["data"], LARGE, LARGE).savev(original + ".new", "jpeg",
                                                                    ["quality"], ["85"])
                        os.replace(original + ".new", original)
                    except (GLib.Error, OSError) as exc:
                        sys.stderr.write("haltia-paint: %s: %s\n" % (original, exc))
                self.pool.submit(save_original)
            self.gallery_stale = True
            if "info" in item:
                item["info"].set_text("✓ Уже в раскрасках")
        pic = next((p for p in load_pictures()[0] if p["id"] == pic_id), None)
        if pic:
            self.open(pic)

    # board
    def open(self, pic):
        # Parse and construct first: a broken file must leave the current page intact.
        # A copy: the gallery's thread may read and drop its regions meanwhile.
        pic = without_regions(pic)
        try:
            board = Board(self, pic)
        except (OSError, EOFError, ET.ParseError, ValueError, TypeError,
                AttributeError, IndexError, KeyError, cairo.Error) as exc:
            sys.stderr.write("haltia-paint: %s: %s\n" % (pic["path"], exc))
            dialogs.info(self.win, "Эту раскраску не открыть.")
            return False
        self.leave_preview()
        write_last(pic["id"])
        self.back_button.show()
        self.find_button.hide()
        # Настройки while painting too: "←" there comes back here.
        self.settings_button.show()
        old = self.stack.get_child_by_name("board")
        if old:
            self.stack.remove(old)
        if self.board:
            self.board.stop()
        self.board = board
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        middle = Gtk.Box()
        box.pack_start(middle, True, True, 0)

        # Icon buttons on the right, in groups, the most used on top:
        # "where?" (large) and undo; zoom in, out, the whole picture; the
        # finished picture to look at.
        tools = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        tools.get_style_context().add_class("tools")
        for name, action, gap in (("find", self.find, False),
                                  ("undo", self.board.undo_last, True),
                                  ("zoom-in", self.zoom_in, False),
                                  ("zoom-out", self.zoom_out, False),
                                  ("whole", self.whole, True),
                                  ("look", self.look, False)):
            tools.pack_start(self.tool(name, action), False, False, 0)
            if gap:
                tools.pack_start(Gtk.Box(), True, True, 0)
        middle.pack_end(tools, False, False, 0)

        # The board moves and zooms the picture itself: a scrolled window
        # costs a third of the frames on the tablet.
        self.view_size = None
        self.zoom = None
        self.whole_back = None
        self.found_number, self.found = None, []  # regions «где?» showed
        middle.pack_start(self.board, True, True, 0)

        pal_scroll = self.pal_scroll = Gtk.ScrolledWindow()
        pal_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        pal_scroll.set_kinetic_scrolling(True)
        pal = Gtk.Box(spacing=8)
        pal.get_style_context().add_class("palette")
        self.swatches = []
        for n, colour in enumerate(pic["palette"]):
            b = Gtk.Button()
            b.get_style_context().add_class("swatch")
            prov = Gtk.CssProvider()
            prov.load_from_data((".swatch { background-color: %s; }" % colour).encode())
            b.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
            fg = "#000000" if text_colour(colour) == (0.0, 0.0, 0.0) else "#ffffff"
            lab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            num = Gtk.Label()
            num.set_markup('<span foreground="%s">%d</span>' % (fg, n + 1))
            left = Gtk.Label()
            left.get_style_context().add_class("left")
            lab.pack_start(num, True, True, 0)
            lab.pack_start(left, False, False, 0)
            b.add(lab)
            b.connect("clicked", lambda _b, k=n: self.choose(k))
            pal.pack_start(b, False, False, 0)
            self.swatches.append((b, left, fg))
        pal_scroll.add(pal)
        box.pack_start(pal_scroll, False, False, 0)
        self.board_box = box
        self.end_bar = None

        box.show_all()
        self.find_tool.set_visible(self.hint_shown)
        self.stack.add_named(box, "board")
        self.stack.set_visible_child_name("board")
        first = next((n for n in range(len(pic["palette"])) if self.board.left(n)), 0)
        self.choose(first)
        if not any(self.board.left(n) for n in range(len(pic["palette"]))):
            # Opened from Готовые: its end, without the sound and replay.
            self.finished(celebrate=False)

        return True

    def tool(self, name, action):
        """A button with a drawn icon, white on blue while it is on; "find"
        is blue and twice as high."""
        b = Gtk.Button()
        b.get_style_context().add_class("tool")
        if name == "find":
            b.get_style_context().add_class("accent")
        icon = Gtk.DrawingArea()
        icon.set_size_request(56, 112 if name == "find" else 56)

        def draw(widget, cr):
            ctx = b.get_style_context()
            light = ctx.has_class("accent") or ctx.has_class("on")
            counted = name == "find" and self.hint_limit
            # With a count under it, the icon moves up a little.
            cr.translate((widget.get_allocated_width() - 56) / 2,
                         (widget.get_allocated_height() - 56) / 2 - (16 if counted else 0))
            draw_icon(cr, name, 56, (1.0, 1.0, 1.0) if light else (0.18, 0.2, 0.21))
            if counted:
                # How many times it is left, under the icon.
                left = str(max(0, self.hint_limit - self.board.hints))
                cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
                cr.set_font_size(26)
                ext = cr.text_extents(left)
                cr.move_to(28 - ext.width / 2 - ext.x_bearing, 88)
                cr.set_source_rgb(1, 1, 1)
                cr.show_text(left)
            return False

        icon.connect("draw", draw)
        b.add(icon)
        if name == "whole":
            self.whole_button = b
        if name == "undo":
            self.undo_tool = b
        if name == "find":
            self.find_tool = b
            self.hints_shown()
        if name == "look":
            # A tap shows the finished picture until the next; held, it
            # shows it while held.
            self.look_button = b
            b.connect("pressed", lambda _b: self.look(True))
            b.connect("released", lambda _b: self.look(False))
        else:
            b.connect("clicked", lambda _b: action())
        return b

    def hints_shown(self):
        """«где?» greyed when its limit for the picture is used up."""
        left = not self.hint_limit or self.board.hints < self.hint_limit
        self.find_tool.set_sensitive(left)
        self.find_tool.queue_draw()

    def find(self):
        """Centre the view on the nearest unpainted region of the chosen
        colour, zoomed in far enough to read its number; counted against
        the limit of Настройки."""
        if self.hint_limit and self.board.hints >= self.hint_limit:
            return
        # Tapped again, it goes on to the next region, not the same one;
        # round again when all were shown.
        b = self.board
        if self.found_number != b.chosen:
            self.found_number, self.found = b.chosen, []
        todo = [i for i in b.of[b.chosen] if i not in b.filled]
        if set(todo) <= set(self.found):
            self.found = []
        i = b.nearest(*b.centre(), shown=self.found)
        if i is None or not self.view_size:
            return
        self.found.append(i)
        b.hints += 1
        b.save_soon()
        self.hints_shown()
        reg = b.regions[i]
        self.forget_whole()
        steps = self.steps()
        # A comfortable number: as large as Настройки say.
        want = self.hint_zoom / (1.2 * max(reg.r, 0.5))
        index = max(self.zoom or 0,
                    next((k for k, z in enumerate(steps) if z >= want), len(steps) - 1))
        self.set_zoom(index, (reg.x, reg.y))

    def on_view_size(self):
        size = self.board.size()
        if size == self.view_size or size[0] < 50:
            return
        first = self.view_size is None
        self.view_size = size
        GLib.idle_add(self.set_zoom, self.zoom, None, not first)

    def steps(self):
        """Zooms: the whole picture in view, then larger by ZOOM_STEP."""
        w, h = self.view_size
        whole = min((w - 4) / self.board.pic["w"], (h - 4) / self.board.pic["h"])
        steps = [whole]
        while steps[-1] * ZOOM_STEP <= MAX_ZOOM:
            steps.append(steps[-1] * ZOOM_STEP)
        return steps

    def zoomed(self, scale):
        """Fingers zoomed to scale: the zoom buttons go on from the step
        nearest to it."""
        steps = self.steps()
        self.zoom = min(range(len(steps)), key=lambda k: abs(math.log(steps[k] / scale)))
        self.forget_whole()

    def set_zoom(self, index, focus=None, smooth=True):
        """Zoom to a step, with focus (a spot of the picture; else the
        middle of the view) in the middle."""
        if not self.board or not self.view_size:
            return False
        steps = self.steps()
        # A picture opens whole, as in the colouring apps.
        index = max(0, min(index or 0, len(steps) - 1))
        self.zoom = index
        self.board.look_at(steps[index], *(focus or self.board.centre()), smooth=smooth)
        return False

    def zoom_in(self):
        if self.zoom is not None:
            self.forget_whole()
            self.set_zoom(self.zoom + 1)

    def zoom_out(self):
        if self.zoom is not None and self.zoom > 0:
            self.forget_whole()
            self.set_zoom(self.zoom - 1)

    def whole(self):
        """Fit the picture to the screen; a second tap goes back."""
        if self.zoom is None:
            return
        if self.whole_back:
            index, focus = self.whole_back
            self.forget_whole()
            self.set_zoom(index, focus)
            return
        if self.zoom == 0:
            return
        self.whole_back = (self.zoom, self.board.centre())
        self.whole_button.get_style_context().add_class("on")
        self.whole_button.queue_draw()
        self.set_zoom(0)

    def forget_whole(self):
        self.whole_back = None
        self.whole_button.get_style_context().remove_class("on")
        self.whole_button.queue_draw()

    def choose(self, number):
        self.board.set_chosen(number)
        self.refresh_swatches()
        # The chosen colour's button in view, also when chosen for her.
        b = self.swatches[number][0]
        GLib.idle_add(self.show_swatch, b)

    def show_swatch(self, b):
        alloc = b.get_allocation()
        adj = self.pal_scroll.get_hadjustment()
        if alloc.x < adj.get_value():
            adj.set_value(max(0, alloc.x - 8))
        elif alloc.x + alloc.width > adj.get_value() + adj.get_page_size():
            adj.set_value(alloc.x + alloc.width + 8 - adj.get_page_size())
        return False

    def refresh_swatches(self):
        for n, (b, left, fg) in enumerate(self.swatches):
            count = self.board.left(n)
            left.set_markup('<span foreground="%s">%s</span>' % (fg, "✓" if count == 0 else str(count)))
            (left.get_style_context().add_class if count == 0
             else left.get_style_context().remove_class)("done")
            ctx = b.get_style_context()
            (ctx.add_class if n == self.board.chosen else ctx.remove_class)("chosen")
            (ctx.add_class if count == 0 else ctx.remove_class)("done")
        # How far the picture is, in the header beside its name.
        done, total = share_done(self.board.pic, self.board.filled)
        self.title.set_text("%s · %d %%" % (self.board.pic["name"], 100 * done // total))

    def region_painted(self, number, tapped=True):
        if self.board.left(number) == 0 and tapped:
            if any(self.board.left(n) for n in range(len(self.board.pic["palette"]))):
                self.feedback.colour_done()
        if self.board.left(number) == 0:
            colours = len(self.board.pic["palette"])
            # The next number with regions left, after this one, round.
            nxt = next(((number + k) % colours for k in range(1, colours + 1)
                        if self.board.left((number + k) % colours)), None)
            if nxt is None:
                self.refresh_swatches()
                self.finished(celebrate=tapped)
                return
            if number == self.board.chosen:
                self.choose(nxt)
                return
        self.refresh_swatches()

    def look(self, down):
        """The finished picture to look at: a tap turns it on, the next
        off; held, it shows while held."""
        if not self.board:
            return
        if down:
            self.look_was, self.look_since = self.board.previewing, time.monotonic()
            self.show_look(True)
        elif self.look_was or time.monotonic() - self.look_since > 0.5:
            self.show_look(False)

    def show_look(self, on):
        if self.board:
            self.board.set_preview(on)
            ctx = self.look_button.get_style_context()
            (ctx.add_class if on else ctx.remove_class)("on")
            self.look_button.queue_draw()

    def finished(self, celebrate=True):
        """The picture is done: the tune and buzz, the whole picture painted
        again before one's eyes (Настройки), then its end: «Готово!» with
        the buttons to keep it, see it again, see the painting itself and
        go back. No dialog: the buttons stay on the screen."""
        self.save()
        b = self.board
        b.show_finished()
        for tool in (self.find_tool, self.undo_tool, self.look_button):
            tool.hide()
        self.pal_scroll.hide()
        self.show_end()
        if celebrate:
            self.feedback.picture_done()
            if self.replay and b.order:
                # The whole picture in view first, then painted again.
                self.forget_whole()
                self.set_zoom(0, smooth=False)
                GLib.idle_add(lambda: b.start_replay() and False)

    def show_end(self):
        if self.end_bar:
            return
        bar = self.end_bar = Gtk.Box(spacing=16)
        bar.get_style_context().add_class("palette")
        done = Gtk.Label(label="Готово!")
        done.get_style_context().add_class("end")
        done.set_margin_start(16)
        done.set_margin_end(16)
        bar.pack_start(done, False, False, 0)
        pic = self.board.pic
        self.original_path = original_of(pic)
        for label, action in (("Сохранить в Галерею", lambda: self.save_to_gallery(pic)),
                              ("Посмотреть ещё раз", self.see_again),
                              ("Оригинал", self.flip_original),
                              ("К раскраскам", self.back)):
            if label == "Оригинал" and not self.original_path:
                continue
            button = Gtk.Button(label=label)
            button.get_style_context().add_class("grade")
            button.connect("clicked", lambda _b, a=action: a())
            if label == "Оригинал":
                self.original_button = button
            bar.pack_start(button, True, True, 0)
        self.board_box.pack_start(bar, False, False, 0)
        bar.show_all()

    def see_again(self):
        self.original_shown(False)
        self.forget_whole()
        self.set_zoom(0, smooth=False)
        GLib.idle_add(lambda: self.board and self.board.start_replay() and False)

    def flip_original(self):
        self.original_shown(not self.board.original)

    def original_shown(self, on):
        """The painting itself in place of the picture, or the picture."""
        self.original_request = request = object()
        board = self.board

        def loaded(pb):
            if self.original_request is request and self.board is board:
                board.set_original(pb)
                if self.original_path:
                    ctx = self.original_button.get_style_context()
                    (ctx.add_class if pb else ctx.remove_class)("on")
            return False

        if not on or not self.original_path:
            loaded(None)
            return
        path = self.original_path

        def work():
            try:
                pb = pixbuf_file(path, 1600, 1600)
            except (OSError, GLib.Error) as exc:
                sys.stderr.write("haltia-paint: %s: %s\n" % (path, exc))
                pb = None
            GLib.idle_add(loaded, pb)

        self.pool.submit(work)

    def save_to_gallery(self, pic):
        """The finished picture as a PNG among the pictures (Галерея shows
        it), drawn in a thread: a large one takes a few seconds."""
        if self.saving:
            return
        self.saving = True
        folder = SAVED
        name = re.sub(r'[/\\:*?"<>|]', " ", pic["name"]).strip() or "Раскраска"

        name = name.encode("utf-8")[:100].decode("utf-8", "ignore")
        name += time.strftime(" %Y-%m-%d")

        def finished(text):
            self.saving = False
            dialogs.info(self.win, text)
            return False

        def work():
            temporary = None
            try:
                os.makedirs(folder, exist_ok=True)
                path = os.path.join(folder, name + ".png")
                n = 2
                while os.path.exists(path):
                    path = os.path.join(folder, "%s %d.png" % (name, n))
                    n += 1
                own = without_regions(pic)
                full = [hex_rgb(c) for c in own["palette"]]
                regs = regions_of(own)
                image = whole_picture(own, 2000, 2000, lambda i: full[regs[i].n])
                with tempfile.NamedTemporaryFile(dir=folder, suffix=".png", delete=False) as fh:
                    temporary = fh.name
                image.write_to_png(temporary)
                os.replace(temporary, path)
                text = "Сохранено в Галерею:\n%s" % os.path.join(os.path.basename(folder),
                                                                 os.path.basename(path))
            except (OSError, cairo.Error) as exc:
                sys.stderr.write("haltia-paint: %s: %s\n" % (folder, exc))
                text = "Не удалось сохранить."
            finally:
                if temporary and os.path.exists(temporary):
                    os.unlink(temporary)
            GLib.idle_add(finished, text)

        threading.Thread(target=work, daemon=True).start()

    # settings
    def on_any_event(self, event, *_data):
        """Every event, then handed to GTK: a button tapped (lifted where it
        went down, on a button that is on) buzzes."""
        kind = event.get_event_type()
        if kind in (Gdk.EventType.TOUCH_BEGIN, Gdk.EventType.BUTTON_PRESS):
            widget = Gtk.get_event_widget(event)
            while widget is not None and not isinstance(widget, Gtk.Button):
                widget = widget.get_parent()
            ok, x, y = event.get_root_coords()
            self.pressed = (widget, x, y) if widget is not None and ok else None
        elif kind in (Gdk.EventType.TOUCH_END, Gdk.EventType.BUTTON_RELEASE) and self.pressed:
            button, x0, y0 = self.pressed
            self.pressed = None
            ok, x, y = event.get_root_coords()
            # A tap, not a scroll that began on a button.
            if ok and abs(x - x0) <= TAP_SLOP and abs(y - y0) <= TAP_SLOP \
                    and button.is_sensitive() and button.get_mapped():
                self.feedback.tapped()
        Gtk.main_do_event(event)

    def int_setting(self, key, default, choices):
        """A number of Настройки that is one of choices, else default."""
        try:
            value = int(self.settings.get(key, str(default)))
        except ValueError:
            return default
        return value if value in dict(choices) else default

