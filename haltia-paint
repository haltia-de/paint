    its Wikidata item, or own-<hash>)."""
    return os.path.join(DOWNLOADED, key + ".jpg")


def hex_rgb(colour):
    return tuple(int(colour[i:i + 2], 16) / 255.0 for i in (1, 3, 5))


def grey(rgb):
    """A region still to paint: grey, as light as the colour it waits for."""
    g = 0.62 + 0.36 * (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2])
    return (g, g, g)


# Where a number's text starts from its middle, by (size, bold, text).
_NUMBER_AT = {}


def draw_regions(cr, pic, scale, regions, fill, outline=None, number=None, ink=INK):
    """Draw these regions (indexes) of a picture at scale: fill(i) gives a
    region's colour or a highlight's Mark (no fill when None), outline(i)
    whether it gets a grey outline, number(i) None or (colour, bold) or
    (colour, bold, halo) for its number; ink: the colour of the picture's
    own outlines."""
    regs = regions_of(pic)
    cr.save()
    cr.scale(scale, scale)
    cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
    # A thin stroke of the region's own colour closes the hairline the
    # antialiasing would leave between two neighbours.
    cr.set_line_width(1.2 / scale)
    for i in regions if fill else ():
        cr.append_path(regs[i].path)
        look = fill(i)
        if hasattr(look, "source"):  # a highlight's pattern (haltia_paint.highlight)
            cr.set_source(look.source(scale))
        else:
            cr.set_source_rgb(*look)
        cr.fill_preserve()
        cr.stroke()
    if outline:
        cr.set_line_width(1.0 / scale)
        cr.set_source_rgb(0.55, 0.55, 0.58)
        for i in regions:
            if outline(i):
                cr.append_path(regs[i].path)
        cr.stroke()
    # The picture's own black outlines, over the regions drawn (only
    # within their boxes when they are a few).
    if fill and pic.get("ink") is not None:
        cr.save()
        if len(regions) < 50:
            # Boxes may overlap: their union, not even-odd.
            cr.set_fill_rule(cairo.FILL_RULE_WINDING)
            for i in regions:
                x0, y0, x1, y1 = regs[i].box
                cr.rectangle(x0 - 1, y0 - 1, x1 - x0 + 2, y1 - y0 + 2)
            cr.clip()
            cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        cr.append_path(pic["ink"])
        cr.set_source_rgb(*ink)
        cr.fill()
        cr.restore()
    cr.restore()
    if not number:
        return
    for bold in (False, True):
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL,
                            cairo.FONT_WEIGHT_BOLD if bold else cairo.FONT_WEIGHT_NORMAL)
        for i in regions:
            reg = regs[i]
            size = int(min(reg.r * 1.2 * scale, NUMBER_MAX))
            style = number(i) if size >= NUMBER_MIN else None
            if not style or style[1] != bold:
                continue
            text = str(reg.n + 1)
            cr.set_font_size(size)
            at = _NUMBER_AT.get((size, bold, text))
            if at is None:
                ext = cr.text_extents(text)
                at = _NUMBER_AT[size, bold, text] = (-ext.width / 2 - ext.x_bearing,
                                                     -ext.height / 2 - ext.y_bearing)
            cr.move_to(reg.x * scale + at[0], reg.y * scale + at[1])
            if len(style) > 2:
                # A halo, so the number reads over a highlight's pattern.
                cr.text_path(text)
                cr.set_source_rgb(*style[2])
                cr.set_line_width(max(2.0, size * 0.18))
                cr.stroke_preserve()
                cr.set_source_rgb(*style[0])
                cr.fill()
            else:
                cr.set_source_rgb(*style[0])
                cr.show_text(text)


def whole_picture(pic, width, height, fill, outline=None, ink=INK):
    """The picture fitted into width x height, as a surface of its size."""
    scale = min(width / pic["w"], height / pic["h"])
    image = cairo.ImageSurface(cairo.FORMAT_RGB24, max(1, round(pic["w"] * scale)),
                               max(1, round(pic["h"] * scale)))
    cr = cairo.Context(image)
    cr.set_source_rgb(1, 1, 1)
    cr.paint()
    draw_regions(cr, pic, scale, range(len(regions_of(pic))), fill, outline, ink=ink)
    return image


# Gallery thumbnails are drawn this large at most (a card shows them
# smaller or so, as it has room), and kept so.
THUMB = 440, 310


def thumbnail(pic, filled, finished, colour_new=False):
    """The gallery picture, kept as a PNG until the progress changes (or
    one kept before 4.7.2, smaller); one not begun in its colours with
    colour_new (Настройки), else pale."""
    finished = finished or (colour_new and not filled)
    path = os.path.join(DATA, "thumbs", pic["id"] + ("-colour" if finished and not filled else "")
                        + ".png")
    try:
        newest = max(pic.get("mtime", 0), os.path.getmtime(progress_path(pic)))
    except OSError:
        newest = pic.get("mtime", 0)
    try:
        if os.path.getmtime(path) >= newest:
            kept = cairo.ImageSurface.create_from_png(path)
            if kept.get_width() >= THUMB[0] - 2 or kept.get_height() >= THUMB[1] - 2:
                return kept
    except (OSError, cairo.Error):
        pass
    loaded = "regions" in pic
    regs = regions_of(pic)
    full = [hex_rgb(c) for c in pic["palette"]]
    # Still to paint: a pale version, so the picture shows.
    pale = [(0.72 + 0.28 * r, 0.72 + 0.28 * g, 0.72 + 0.28 * b) for r, g, b in full]
    image = whole_picture(pic, THUMB[0], THUMB[1], lambda i: (full if finished or i in filled else pale)
                          [regs[i].n], ink=INK_PREVIEW)
    if not loaded:
        # Not needed again until the picture is opened.
        drop_regions(pic)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        image.write_to_png(path + ".new")
        os.replace(path + ".new", path)
    except (OSError, cairo.Error):
        pass
    return image


def draw_icon(cr, name, size, rgb):
    """Icons drawn on a 48x48 grid with round 4-unit strokes."""
    cr.save()
    cr.scale(size / 48.0, size / 48.0)
    cr.set_source_rgb(*rgb)
    cr.set_line_width(4)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.set_line_join(cairo.LINE_JOIN_ROUND)
    if name == "back":
        cr.move_to(40, 24)
        cr.line_to(9, 24)
        cr.move_to(21, 11)
        cr.line_to(8, 24)
        cr.line_to(21, 37)
        cr.stroke()
    elif name in ("zoom-in", "zoom-out"):
        cr.arc(20, 20, 13, 0, 2 * math.pi)
        cr.move_to(30, 30)
        cr.line_to(42, 42)
        cr.move_to(13, 20)
        cr.line_to(27, 20)
        if name == "zoom-in":
            cr.move_to(20, 13)
            cr.line_to(20, 27)
        cr.stroke()
    elif name == "whole":
        # Four corners drawn out to the edges: "the whole picture", told
        # apart from the eye of "look".
        for x, y, dx, dy in ((6, 6, 1, 1), (42, 6, -1, 1), (6, 42, 1, -1), (42, 42, -1, -1)):
            cr.move_to(x, y + 12 * dy)
            cr.line_to(x, y)
            cr.line_to(x + 12 * dx, y)
        cr.stroke()
        cr.rectangle(17, 17, 14, 14)
        cr.fill()
    elif name == "find":
        cr.arc(24, 24, 14, 0, 2 * math.pi)
        for x0, y0, x1, y1 in ((24, 3, 24, 12), (24, 36, 24, 45), (3, 24, 12, 24),
                               (36, 24, 45, 24)):
            cr.move_to(x0, y0)
            cr.line_to(x1, y1)
        cr.stroke()
        cr.arc(24, 24, 4.5, 0, 2 * math.pi)
        cr.fill()
    elif name == "undo":
        # Most of a circle from the top round to the lower left, with the
        # arrow head at the top pointing left: "turn back".
        cr.arc(25, 27, 15, -0.5 * math.pi, 0.85 * math.pi)
        cr.stroke()
        cr.move_to(9, 12)
        cr.line_to(22, 3)
        cr.line_to(22, 21)
        cr.close_path()
        cr.fill()
    elif name == "look":
        cr.move_to(4, 24)
        cr.curve_to(14, 9, 34, 9, 44, 24)
        cr.curve_to(34, 39, 14, 39, 4, 24)
        cr.close_path()
        cr.stroke()
        cr.arc(24, 24, 7, 0, 2 * math.pi)
        cr.fill()
    cr.restore()


def text_colour(colour):
    r, g, b = hex_rgb(colour)
    return (0.0, 0.0, 0.0) if 0.299 * r + 0.587 * g + 0.114 * b > 0.55 else (1.0, 1.0, 1.0)


# --- the picture being painted ----------------------------------------------
class Board(Gtk.DrawingArea):
    def __init__(self, app, pic):
        super().__init__()
        self.app = app
        self.pic = pic
        self.regions = regions_of(pic)
        self.filled = load_progress(pic)
        self.hints = load_hints(pic)  # times «где?» was used
        self.order = load_order(pic, self.filled, self.regions)  # as painted
        self.full = [hex_rgb(c) for c in pic["palette"]]
        self.grey = [grey(c) for c in self.full]
        self.counts = [0] * len(self.full)  # regions left of each number
        self.of = [[] for _ in self.full]  # every region of each number
        for i, reg in enumerate(self.regions):
            self.of[reg.n].append(i)
            if i not in self.filled:
                self.counts[reg.n] += 1
        self.chosen = 0
        self.scale = 1.0
        self.tiles = collections.OrderedDict()  # (column, row) -> surface
        # Tiles are drawn by a thread of their own; meanwhile their place
        # shows the tiles of the zoom before stretched, (scale, tiles), over
        # the whole picture small, (scale, surface).
        self.old = None
        self.base = None
        self.zooms = 0  # one more at every zoom: tiles of another are dropped
        self.asked = set()  # (zooms, tile) being drawn
        self.version = 0  # one more at every tap or undo
        self.changes = []  # (version, region) of the taps and undos
        self.jobs = queue.PriorityQueue()
        self.job_order = itertools.count()
        threading.Thread(target=self.draw_tiles, daemon=True).start()
        self.previewing = False
        self.finished = False
        self.replay = None  # the picture painted again at its end
        self.original = None  # the painting itself shown, a pixbuf
        self.save_timer = None
        self.undo = []  # the regions painted, in order
        self.wrong = None
        # Taps are tested against the regions' paths on a context of its own.
        self.probe = cairo.Context(cairo.ImageSurface(cairo.FORMAT_A8, 1, 1))
        self.probe.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
        # The view: the board, the picture at scale, shows from (ox, oy) of
        # it; while a zoom is on its way it shows at shown, stretched from
        # the tiles at scale. A drag moves it and lets it glide on.
        self.ox = self.oy = 0.0
        self.shown = self.scale
        self.snap = None
        self.zooming = None  # (from scale, to, from centre, to centre, start)
        self.glide = None  # (speed x, speed y, time) of a picture let go
        self.trail = []  # (time, ox, oy) of the drag, for its speed
        self.moved = 0.0
        self.press = None  # a mouse button held: (x, y, ox, oy) then
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.TOUCH_MASK)
        self.connect("draw", self.on_draw)
        self.connect("size-allocate", lambda _w, _a: self.app.on_view_size())
        # A mouse: press, drag, release.
        self.connect("button-press-event", self.on_press)
        self.connect("motion-notify-event", self.on_motion)
        self.connect("button-release-event", self.on_release)
        # Fingers are followed one by one, not with GTK's gestures: those
        # follow only the first finger (and keep its moves from the rest),
        # so a thumb resting on the screen, or a finger whose lift the
        # tablet lost after a palm, would stop every tap. Any finger that
        # does not move taps; one moving finger drags; two fingers zoom.
        self.fingers = {}  # sequence -> what it did
        self.panning = None  # the finger dragging the picture
        self.pinching = None  # (finger a, b, scale, distance, spot, where on screen)
        self.touched = 0.0  # when a finger last did something
        self.connect("touch-event", self.on_touch)
        self.ticking = False

    def set_scale(self, scale):
        if self.tiles:
            self.old = (self.scale, self.tiles)
        self.zooms += 1
        self.scale = self.shown = scale
        self.tiles = collections.OrderedDict()
        self.queue_draw()

    # the view
    def size(self):
        return self.get_allocated_width(), self.get_allocated_height()

    def centre(self):
        """The spot of the picture in the middle of the view."""
        w, h = self.size()
        return (self.ox + w / 2) / self.shown, (self.oy + h / 2) / self.shown

    def offsets(self, scale, x, y):
        """Where the view starts on the board at scale to show (x, y) of the
        picture in its middle, as far as the picture reaches; a picture
        smaller than the view sits in the middle."""
        w, h = self.size()
        out = []
        for at, side, page in ((x, self.pic["w"], w), (y, self.pic["h"], h)):
            full = side * scale
            out.append((full - page) / 2 if full <= page
                       else min(max(at * scale - page / 2, 0), full - page))
        return out

    def put(self, x, y):
        """Show (x, y) of the picture in the middle of the view."""
        self.ox, self.oy = self.offsets(self.shown, x, y)
        self.queue_draw()

    def look_at(self, scale, x, y, smooth=True):
        """Zoom to scale with (x, y) in the middle: at once, or in a short
        glide from the view now."""
        self.glide = None
        if not smooth or not self.get_mapped() or abs(scale - self.shown) < 1e-6:
            self.zooming = None
            if abs(scale - self.scale) > 1e-6:
                self.set_scale(scale)
            self.put(x, y)
            return
        # The view now, to stretch while the zoom goes on: one picture to
        # draw a frame rather than many tiles.
        w, h = self.size()
        snap = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
        self.on_draw(self, cairo.Context(snap))
        self.snap = (snap, self.shown, round(self.ox), round(self.oy))
        self.zooming = (self.shown, scale, self.centre(), (x, y), time.monotonic())
        # The tiles of the zoom it goes to are drawn meanwhile, those of
        # its view first.
        shown = self.shown
        self.set_scale(scale)
        self.shown = shown
        ox, oy = self.offsets(scale, x, y)
        for row in range(int(oy // TILE), int((oy + h - 1) // TILE) + 1):
            for column in range(int(ox // TILE), int((ox + w - 1) // TILE) + 1):
                self.ask((column, row), 0)
        self.tick()

    def tick(self):
        """Move the view every frame while a zoom or glide is on."""
        if not self.ticking:
            self.ticking = True
            self.add_tick_callback(self.on_tick)

    def on_tick(self, _widget, _clock):
        now = time.monotonic()
        if self.zooming:
            s0, s1, (x0, y0), (x1, y1), start = self.zooming
            t = min(1.0, (now - start) / ZOOM_TIME)
            t = 1 - (1 - t) ** 2  # quick, then gently in place
            if t >= 1:
                self.zooming = None
                self.snap = None
                self.shown = s1
                self.put(x1, y1)
            else:
                self.shown = s0 * (s1 / s0) ** t
                self.put(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t)
        elif self.glide:
            vx, vy, last = self.glide
            dt = now - last
            ox, oy = self.ox, self.oy
            self.ox += vx * dt
            self.oy += vy * dt
            x, y = self.centre()
            self.put(x, y)
            slow = math.exp(-dt * GLIDE)
            vx, vy = vx * slow, vy * slow
            stuck = abs(self.ox - ox) < 0.5 and abs(self.oy - oy) < 0.5
            self.glide = None if stuck or math.hypot(vx, vy) < 40 else (vx, vy, now)
        self.ticking = bool(self.zooming or self.glide)
        return self.ticking

    def on_touch(self, _widget, event):
        seq, x, y = event.touch.sequence, event.x, event.y
        now = self.touched = time.monotonic()
        kind = event.type
        if kind == Gdk.EventType.TOUCH_BEGIN:
            self.glide = None
            # A finger whose lift was lost stops counting after a while.
            for k in [k for k, f in self.fingers.items() if now - f["last"] > 8]:
                del self.fingers[k]
            # Another finger on the screen just now makes this one part of
            # a gesture: it does not tap. A finger lying still for a while
            # (a thumb holding the tablet) does not count.
            others = [k for k, g in self.fingers.items() if now - g["last"] < LIVE]
            for k in others:
                self.fingers[k]["gesture"] = True
            self.fingers[seq] = {"x0": x, "y0": y, "x": x, "y": y, "t0": now, "last": now,
                                 "moved": False, "gesture": bool(others), "updates": 0}
            return False
        f = self.fingers.get(seq)
        if f is None:
            return False
        if kind == Gdk.EventType.TOUCH_UPDATE:
            f["updates"] += 1
            self.finger_moved(seq, f, x, y, now)
            return False
        # The finger is lifted, or the tablet took it back (a palm).
        del self.fingers[seq]
        if self.pinching and seq in self.pinching[:2]:
            self.pinch_end()
        elif self.panning == seq:
            self.panning = None
            if kind == Gdk.EventType.TOUCH_END:
                self.let_go(now)
        elif (kind == Gdk.EventType.TOUCH_END and not f["moved"] and not f["gesture"]
              and now - f["t0"] < 1.5):
            self.tapped(x, y)
        return False

    def finger_moved(self, seq, f, x, y, now):
        f["x"], f["y"], f["last"] = x, y, now
        if not f["moved"] and math.hypot(x - f["x0"], y - f["y0"]) > TAP_SLOP:
            f["moved"] = True
        if self.zooming:
            return
        if self.pinching:
            self.pinch_to()
            return
        # Two fingers on the screen zoom once one of them moves (GTK 3
        # passes a first finger's moves as mouse moves, mostly not at all,
        # while a second is down: its place stays where it was).
        live = [k for k, g in self.fingers.items() if now - g["last"] < LIVE or k == seq]
        if len(live) >= 2 and f["moved"]:
            other = max((k for k in live if k != seq), key=lambda k: self.fingers[k]["t0"])
            self.pinch_from(other, seq)
        elif f["moved"] and not f["gesture"]:
            self.drag_by(seq, f, now)

    def drag_by(self, seq, f, now):
        """One finger moves the picture with it."""
        if self.panning != seq:
            self.panning = seq
            f["px"], f["py"] = f["x0"], f["y0"]
            self.trail = [(now, self.ox, self.oy)]
        self.ox -= f["x"] - f["px"]
        self.oy -= f["y"] - f["py"]
        f["px"], f["py"] = f["x"], f["y"]
        self.put(*self.centre())
        self.trail = [p for p in self.trail if now - p[0] < 0.1] + [(now, self.ox, self.oy)]

    def let_go(self, now):
        """A drag ends: the picture glides on at the speed it was thrown."""
        recent = [p for p in self.trail if now - p[0] < 0.1]
        if len(recent) >= 2:
            (t0, x0, y0), (t1, x1, y1) = recent[0], recent[-1]
            if t1 - t0 > 0.01:
                self.glide = ((x1 - x0) / (t1 - t0), (y1 - y0) / (t1 - t0), now)
                self.tick()

    def pinch_from(self, a, b):
        """Two fingers start to zoom: the view so far, to stretch."""
        fa, fb = self.fingers[a], self.fingers[b]
        fa["gesture"] = fb["gesture"] = True
        self.panning = None
        mx, my = (fa["x"] + fb["x"]) / 2, (fa["y"] + fb["y"]) / 2
        w, h = self.size()
        snap = cairo.ImageSurface(cairo.FORMAT_RGB24, w, h)
        self.on_draw(self, cairo.Context(snap))
        self.snap = (snap, self.shown, round(self.ox), round(self.oy))
        # The line between where the fingers landed: the moving one has
        # gone a little way already.
        d0 = max(1.0, math.hypot(fb["x0"] - fa["x0"], fb["y0"] - fa["y0"]))
        self.pinching = (a, b, self.shown, d0,
                         ((mx + self.ox) / self.shown, (my + self.oy) / self.shown), (mx, my),
                         (fa["x0"], fa["y0"], fb["x0"], fb["y0"]),
                         ((fb["x0"] - fa["x0"]) / d0, (fb["y0"] - fa["y0"]) / d0),
                         (fa["updates"], fb["updates"]))

    def pinch_to(self):
        a, b, s0, d0, (px, py), (mx, my), (ax, ay, bx, by), (ux, uy), (na, nb) = self.pinching
        fa, fb = self.fingers[a], self.fingers[b]
        low = self.app.steps()[0] if self.app.view_size else s0
        # Only moves along the line between the fingers zoom: two fingers
        # moving side by side do not. GTK 3 passes the moves of only one of
        # them (the second): the other is taken to move as far the other way.
        ra = (fa["x"] - ax) * ux + (fa["y"] - ay) * uy
        rb = (fb["x"] - bx) * ux + (fb["y"] - by) * uy
        if fa["updates"] == na:
            ra = -rb
        elif fb["updates"] == nb:
            rb = -ra
        d = d0 + rb - ra
        self.shown = min(max(s0 * max(d, 1.0) / d0, low), MAX_ZOOM)
        # Zoom about the spot where the fingers met; they do not move the
        # picture (one finger does that).
        w, h = self.size()
        self.put((px * self.shown - mx + w / 2) / self.shown, (py * self.shown - my + h / 2) / self.shown)

    def pinch_end(self):
        """One of the two fingers lifted: the zoom stays where it got to;
        the other finger neither taps nor drags any more."""
        a, b = self.pinching[:2]
        for k in (a, b):
            if k in self.fingers:
                self.fingers[k]["gesture"] = True
                self.fingers[k]["moved"] = False
        self.pinching = None
        self.snap = None
        x, y = self.centre()
        shown = self.shown
        self.shown = self.scale
        self.app.zoomed(shown)
        self.look_at(shown, x, y, smooth=False)

    # a mouse
    def mouse(self, event):
        """Whether an event is a mouse's own: GTK also makes mouse events of
        fingers (a second finger landing even "clicks")."""
        return not event.get_pointer_emulated() and time.monotonic() - self.touched > 1

    def on_press(self, _widget, event):
        if event.button != 1 or not self.mouse(event):
            return False
        self.glide = None
        self.moved = 0.0
        self.press = (event.x, event.y, self.ox, self.oy)
        self.trail = [(time.monotonic(), self.ox, self.oy)]
        return True

    def on_motion(self, _widget, event):
        if self.fingers and not self.press:
            # GTK 3 turns some of a first finger's moves into mouse moves
            # while a second finger is down (not marked as made from a
            # finger): too few to follow it by; that finger counts as still.
            return True
        if not self.mouse(event) or self.zooming or not self.press:
            return False
        x0, y0, ox0, oy0 = self.press
        self.moved = max(self.moved, math.hypot(event.x - x0, event.y - y0))
        self.ox, self.oy = ox0 - (event.x - x0), oy0 - (event.y - y0)
        self.put(*self.centre())
        now = time.monotonic()
        self.trail = [p for p in self.trail if now - p[0] < 0.1] + [(now, self.ox, self.oy)]
        return True

    def on_release(self, _widget, event):
        if event.button != 1 or not self.mouse(event) or not self.press:
            return False
        self.press = None
        if self.moved > TAP_SLOP:
            self.let_go(time.monotonic())
        else:
            self.tapped(event.x, event.y)
        return True

    def queue_board(self, x, y, w, h):
        """Draw again a rectangle of the board (not of the view)."""
        self.queue_draw_area(int(x - round(self.ox)) - 1, int(y - round(self.oy)) - 1,
                             int(w) + 3, int(h) + 3)


    def stop(self):
        """No more tiles: the board is closed."""
        self.zooms += 1
        self.jobs.put((-9, 0, None))

    def left(self, number):
        return self.counts[number]

    def looks(self, filled, chosen):
        """How regions look with these painted and this number chosen:
        (fill, outline, number) for draw_regions. Still to paint: grey,
        outlined, a dark grey number (it reads on the lightest grey too); those of the chosen number in the
        highlight of Настройки (stripes at first) with a bold dark number
        in a white halo."""
        regs = self.regions
        look = self.app.highlight
        mark = look.mark(self.full[chosen]) if chosen is not None else None
        text, halo = look.number

        def fill(i):
            n = regs[i].n
            if i in filled:
                return self.full[n]
            return mark if n == chosen else self.grey[n]

        def number(i):
            if i in filled:
                return None
            return (text, True, halo) if regs[i].n == chosen else ((0.20, 0.20, 0.22), False)

        return fill, lambda i: i not in filled, number

    def draw_tile(self, scale, key, filled, chosen):
        """The board at key (column, row) of TILE-pixel squares at scale,
        with these regions painted and this number chosen."""
        column, row = key
        image = cairo.ImageSurface(cairo.FORMAT_RGB24, TILE, TILE)
        cr = cairo.Context(image)
        cr.set_source_rgb(0.9, 0.9, 0.89)
        cr.paint()
        cr.translate(-column * TILE, -row * TILE)
        # A number can reach over the edge of the tile its region is in.
        m = NUMBER_MAX / scale
        todo = regions_in(self.pic, column * TILE / scale - m, row * TILE / scale - m,
                          (column + 1) * TILE / scale + m, (row + 1) * TILE / scale + m)
        draw_regions(cr, self.pic, scale, todo, *self.looks(filled, chosen))
        image.flush()
        return image

    def draw_base(self, filled):
        """The whole picture at 1 px a unit, without numbers."""
        image = whole_picture(self.pic, self.pic["w"], self.pic["h"],
                              *self.looks(filled, None)[:2])
        image.flush()
        return image

    def draw_tiles(self):
        """The thread that draws tiles, those on the screen first. cairo
        lets the rest of the program run while it fills."""
        while True:
            _order, _n, job = self.jobs.get()
            if job is None:
                return
            zooms, scale, key, filled, chosen, version = job
            if key is not None and zooms != self.zooms:
                continue
            try:
                image = (self.draw_base(filled) if key is None
                         else self.draw_tile(scale, key, filled, chosen))
            except Exception as exc:  # a drawing must not stop the thread
                sys.stderr.write("haltia-paint: tile %s: %s\n" % (key, exc))
                continue
            GLib.idle_add(self.tile_ready, zooms, scale, key, chosen, image, version)

    def ask(self, key, order):
        """Have a tile drawn (key None: the whole picture small)."""
        # The small whole picture is the same at every zoom.
        zooms = -1 if key is None else self.zooms
        if (zooms, key) in self.asked or key in self.tiles:
            return
        self.asked.add((zooms, key))
        self.jobs.put((order, next(self.job_order),
                       (zooms, self.scale, key, frozenset(self.filled), self.chosen,
                        self.version)))

    def tile_ready(self, zooms, scale, key, chosen, image, version):
        self.asked.discard((zooms, key))
        if key is None:
            self.base = (1.0, image)
            todo = [i for v, i in self.changes if v > version]
            for i in todo:
                self.paint_into(image, 1.0, (0, 0), i, numbers=False)
            self.queue_draw()
            return False
        if zooms != self.zooms:
            return False
        if chosen != self.chosen:
            # Another colour was chosen meanwhile: draw it again.
            self.queue_board(key[0] * TILE, key[1] * TILE, TILE, TILE)
            return False
        # Taps and undos while it was drawn.
        for v, i in self.changes:
            if v > version and self.meets(key, i):
                self.paint_into(image, scale, key, i)
        self.tiles[key] = image
        while len(self.tiles) > MAX_TILES:
            self.tiles.popitem(last=False)
        if not (self.zooming or self.pinching) and all(k in self.tiles for k in self.in_view()):
            self.old = None
        self.queue_board(key[0] * TILE, key[1] * TILE, TILE, TILE)
        return False

    def in_view(self, more=0):
        """The tiles on the screen, and more around them."""
        w, h = self.size()
        x0, y0 = self.ox, self.oy
        x1, y1 = x0 + w, y0 + h
        columns = math.ceil(self.scale * self.pic["w"] / TILE)
        rows = math.ceil(self.scale * self.pic["h"] / TILE)
        return [(c, r) for r in range(max(0, int(y0 // TILE) - more),
                                      min(rows, int((y1 - 1) // TILE) + 1 + more))
                for c in range(max(0, int(x0 // TILE) - more),
                               min(columns, int((x1 - 1) // TILE) + 1 + more))]

    def meets(self, key, i):
        s = self.scale
        x0, y0, x1, y1 = self.regions[i].box
        m = NUMBER_MAX
        return (key[0] * TILE < x1 * s + m and (key[0] + 1) * TILE > x0 * s - m
                and key[1] * TILE < y1 * s + m and (key[1] + 1) * TILE > y0 * s - m)

    def on_draw(self, _widget, cr):
        cr.set_source_rgb(0.9, 0.9, 0.89)
        cr.paint()
        # Whole pixels: a tile then is copied, not resampled (ten times
        # quicker on the tablet).
        cr.translate(-round(self.ox), -round(self.oy))
        if self.zooming or self.pinching:
            # A zoom on its way: the whole picture small, and over it the
            # view as it was, both stretched.
            cr.save()
            cr.scale(self.shown / self.scale, self.shown / self.scale)
            self.stand_in(cr, [])
            cr.restore()
            snap, scale, ox, oy = self.snap
            cr.scale(self.shown / scale, self.shown / scale)
            cr.set_source_surface(snap, ox, oy)
            cr.get_source().set_filter(cairo.FILTER_FAST)
            cr.paint()
            return False
        x0, y0, x1, y1 = cr.clip_extents()
        s = self.scale
        if self.replay:
            r = self.replay
            cr.save()
            cr.scale(s / r["scale"], s / r["scale"])
            cr.set_source_surface(r["surface"], 0, 0)
            cr.paint()
            cr.restore()
            return False
        if self.original:
            # The painting fitted into the picture's place.
            pb = self.original
            w, h = s * self.pic["w"], s * self.pic["h"]
            k = min(w / pb.get_width(), h / pb.get_height())
            cr.translate((w - pb.get_width() * k) / 2, (h - pb.get_height() * k) / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
            return False
        if self.previewing or self.finished:
            cr.rectangle(0, 0, s * self.pic["w"], s * self.pic["h"])
            cr.set_source_rgb(1, 1, 1)
            cr.fill()
            draw_regions(cr, self.pic, s, regions_in(self.pic, x0 / s, y0 / s, x1 / s, y1 / s),
                         lambda i: self.full[self.regions[i].n])
            return False
        if self.base is None:
            self.ask(None, -1)
        missing = []
        columns = math.ceil(s * self.pic["w"] / TILE)
        rows = math.ceil(s * self.pic["h"] / TILE)
        for row in range(max(0, int(y0 // TILE)), min(rows, int((y1 - 1) // TILE) + 1)):
            for column in range(max(0, int(x0 // TILE)), min(columns, int((x1 - 1) // TILE) + 1)):
                image = self.tiles.get((column, row))
                if image is None:
                    missing.append((column, row))
                    self.ask((column, row), 0)
                    continue
                self.tiles.move_to_end((column, row))
                cr.set_source_surface(image, column * TILE, row * TILE)
                cr.rectangle(column * TILE, row * TILE, TILE, TILE)
                cr.fill()
        if missing:
            self.stand_in(cr, missing)
        # Then the tiles around the screen, for the next drag.
        for key in self.in_view(1):
            if len(self.tiles) + len(self.asked) < MAX_TILES:
                self.ask(key, 1)
        if self.wrong is not None:
            cr.save()
            cr.scale(s, s)
            cr.append_path(self.regions[self.wrong].path)
            cr.restore()
            cr.set_source_rgb(0.88, 0.11, 0.14)
            cr.set_line_width(4)
            cr.stroke()
        for i in self.ringed():
            # Blue on white, so it shows on dark and light alike.
            reg = self.regions[i]
            cr.new_path()
            cr.arc(reg.x * s, reg.y * s, max(reg.r * s + 16, 30), 0, 2 * math.pi)
            cr.set_source_rgb(1, 1, 1)
            cr.set_line_width(11)
            cr.stroke_preserve()
            cr.set_source_rgb(0.11, 0.44, 0.85)
            cr.set_line_width(5)
            cr.stroke()
        return False

    def ringed(self):
        """The regions of the chosen colour with a ring round them: its
        last few, when Настройки want rings."""
        if not self.app.rings or self.counts[self.chosen] > RING_LEFT:
            return []
        return [i for i in self.of[self.chosen] if i not in self.filled]

    def stand_in(self, cr, missing):
        """The places of tiles not drawn yet: the whole picture small, and
        after zooming in the tiles of the zoom before, stretched (with no
        tiles missing: the whole picture small, everywhere). Quick rather
        than fine: it shows for a moment."""
        cr.save()
        cr.rectangle(0, 0, self.scale * self.pic["w"], self.scale * self.pic["h"])
        cr.clip()
        if missing:
            for column, row in missing:
                cr.rectangle(column * TILE, row * TILE, TILE, TILE)
            cr.clip()
        cr.set_source_rgb(0.9, 0.9, 0.89)
        cr.paint()
        if self.base:
            scale, image = self.base
            cr.save()
            cr.scale(self.scale / scale, self.scale / scale)
            cr.set_source_surface(image, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_FAST)
            cr.paint()
            cr.restore()
        layers = []
        if self.old and self.old[0] < self.scale and missing:
            layers.append(self.old)
        for scale, tiles in layers:
            cr.save()
            f = self.scale / scale
            x0, y0, x1, y1 = cr.clip_extents()
            cr.scale(f, f)
            x0, y0, x1, y1 = x0 / f, y0 / f, x1 / f, y1 / f
            for (c, r), image in tiles.items():
                if c * TILE < x1 and (c + 1) * TILE > x0 and r * TILE < y1 and (r + 1) * TILE > y0:
                    cr.set_source_surface(image, c * TILE, r * TILE)
                    cr.get_source().set_filter(cairo.FILTER_FAST)
                    cr.paint()
            cr.restore()
        cr.restore()

    def redraw(self, i):
        """Show a region's place again (its tiles stay)."""
        s = self.scale
        x0, y0, x1, y1 = self.regions[i].box
        self.queue_board(x0 * s - NUMBER_MAX, y0 * s - NUMBER_MAX,
                         (x1 - x0) * s + 2 * NUMBER_MAX, (y1 - y0) * s + 2 * NUMBER_MAX)

    def paint_into(self, image, scale, key, i, numbers=True):
        """Draw a region as it is now into a tile (or the small whole
        picture): its colour, or grey with its number; then the outlines
        of the unpainted regions around it, which its edge covered a little."""
        x0, y0, x1, y1 = self.regions[i].box
        around = [j for j in regions_in(self.pic, x0, y0, x1, y1) if j not in self.filled]
        cr = cairo.Context(image)
        cr.translate(-key[0] * TILE, -key[1] * TILE)
        fill, _outline, number = self.looks(self.filled, self.chosen if numbers else None)
        draw_regions(cr, self.pic, scale, [i], fill)
        draw_regions(cr, self.pic, scale, around, None, lambda j: True,
                     (lambda j: number(j) if j == i else None) if numbers else None)
        image.flush()

    def paint_over(self, i):
        """A tap or undo changed region i: draw it into the tiles kept, the
        small whole picture too, rather than drawing them again."""
        self.version += 1
        self.changes.append((self.version, i))
        del self.changes[:-500]
        for key, image in self.tiles.items():
            if self.meets(key, i):
                self.paint_into(image, self.scale, key, i)
        if self.base:
            self.paint_into(self.base[1], self.base[0], (0, 0), i, numbers=False)
        if self.app.rings and self.counts[self.regions[i].n] <= RING_LEFT + 1:
            # Rings reach beyond the region: the whole view again.
            self.queue_draw()
        else:
            self.redraw(i)

    def set_chosen(self, number):
        """Choose a number: its regions take the highlight in the tiles on
        the screen, those of the number before grey; tiles off the screen are
        drawn again when needed."""
        old, self.chosen = self.chosen, number
        if old == number:
            return
        view = set(self.in_view()) if self.get_mapped() else set()
        for key in [k for k in self.tiles if k not in view]:
            del self.tiles[key]
        for key, image in self.tiles.items():
            for n in (old, number):
                for i in self.of[n]:
                    if i not in self.filled and self.meets(key, i):
                        self.paint_into(image, self.scale, key, i)
        self.queue_draw()

    def set_preview(self, on):
        self.previewing = on
        self.queue_draw()

    def show_finished(self):
        self.finished = True
        self.queue_draw()

    def set_original(self, pixbuf):
        """Show the painting itself in place of the picture (None: not)."""
        self.original = pixbuf
        self.queue_draw()

    def start_replay(self, done=None):
        """The picture painted again, region by region in the order they
        were painted, over some 8 s; done() at the end. A tap skips to it."""
        self.original = None
        s = self.scale
        surface = cairo.ImageSurface(cairo.FORMAT_RGB24, math.ceil(s * self.pic["w"]),
                                     math.ceil(s * self.pic["h"]))
        cr = cairo.Context(surface)
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        self.replay = {"surface": surface, "scale": s, "order": list(self.order), "at": 0,
                       "done": done}
        self.queue_draw()
        GLib.timeout_add(REPLAY_TICK, self.replay_step)

    def replay_step(self, everything=False):
        r = self.replay
        if r is None:
            return False
        order = r["order"]
        upto = len(order) if everything else r["at"] + max(1, len(order) // REPLAY_STEPS)
        draw_regions(cairo.Context(r["surface"]), self.pic, r["scale"], order[r["at"]:upto],
                     lambda i: self.full[self.regions[i].n])
        r["at"] = upto
        self.queue_draw()
        if upto < len(order):
            return True
        self.replay = None
        if r["done"]:
            r["done"]()
        return False

    def skip_replay(self):
        if self.replay:
            self.replay_step(everything=True)

    def save_soon(self):
        # A tap must not wait for the disk; write a moment after the last.
        if self.save_timer:
            GLib.source_remove(self.save_timer)
        self.save_timer = GLib.timeout_add(800, self.save_now)

    def save_now(self):
        if self.save_timer:
            GLib.source_remove(self.save_timer)
            self.save_timer = None
            save_progress(self.pic, self.filled, self.hints, self.order)
        return False

    def hit(self, x, y):
        """The region at (x, y) in picture units, or None."""
        for i in regions_in(self.pic, x, y, x, y):
            self.probe.new_path()
            self.probe.append_path(self.regions[i].path)
            if self.probe.in_fill(x, y):
                return i
        return None

    def near(self, x, y, reach):
        """The unpainted region of the chosen number that (x, y) is in or
        closest to, within reach; or None."""
        todo = [i for i in regions_in(self.pic, x - reach, y - reach, x + reach, y + reach)
                if self.regions[i].n == self.chosen and i not in self.filled]
        for part in (0.25, 0.5, 1.0):
            self.probe.set_line_width(2 * reach * part)
            for i in todo:
                self.probe.new_path()
                self.probe.append_path(self.regions[i].path)
                if self.probe.in_fill(x, y) or self.probe.in_stroke(x, y):
                    return i
        return None

    def tapped(self, px, py):
        if self.replay:
            self.skip_replay()
            return
        if self.previewing:
            # A tap on the finished picture shown goes back to painting.
            self.app.show_look(False)
            return
        # Not while the picture moves.
        if self.finished or self.zooming or self.pinching:
            return
        x, y = (px + round(self.ox)) / self.scale, (py + round(self.oy)) / self.scale
        i = self.hit(x, y)
        if i is None or i in self.filled or self.regions[i].n != self.chosen:
            # A finger beside a small region of the chosen number.
            reach = self.app.finger
            near = self.near(x, y, reach / self.scale) if reach else None
            if near is None:
                if i is not None and i not in self.filled:
                    # The red outline and a quiet sound say "not this one".
                    self.wrong = i
                    self.redraw(i)
                    GLib.timeout_add(1000, self.clear_wrong, i)
                    self.app.feedback.missed()
                return
            i = near
        self.filled.add(i)
        self.counts[self.chosen] -= 1
        self.undo.append(i)
        self.order.append(i)
        if self.counts[self.chosen]:
            # Felt as a tap (a colour done has a buzz of its own).
            self.app.feedback.hit()
        self.paint_over(i)
        self.save_soon()
        self.app.region_painted(self.chosen)

    def nearest(self, fx, fy, shown=()):
        """The unpainted region of the chosen number whose number is
        closest to (fx, fy), in picture units; one not in shown while there
        are others."""
        todo = [i for i in self.of[self.chosen] if i not in self.filled]
        if not todo:
            return None
        todo = [i for i in todo if i not in shown] or todo
        return min(todo, key=lambda i: (self.regions[i].x - fx) ** 2 + (self.regions[i].y - fy) ** 2)

    def clear_wrong(self, i):
        if self.wrong == i:
            self.wrong = None
            self.redraw(i)
        return False

    def undo_last(self):
        # A finished picture stays finished.
        if not self.undo or self.finished:
            return
        i = self.undo.pop()
        self.filled.discard(i)
        if self.order and self.order[-1] == i:
            self.order.pop()
        number = self.regions[i].n
        self.counts[number] += 1
        self.paint_over(i)
        self.save_soon()
        self.app.region_painted(number)


IMAGE_TYPES = (".jpg", ".jpeg", ".png", ".webp")


def picked():
    """The pictures chosen through the file chooser, last first (a
    Flatpak's portal gives them paths of their own)."""
    try:
        with open(os.path.join(DATA, "picked.json")) as fh:
            return [p for p in json.load(fh) if isinstance(p, str)]
    except (OSError, ValueError):
        return []


def wd_qid(pic):
    """The Wikidata item of a downloaded picture ("wd-Q123-3b"), or None."""
    m = re.match(r"wd-(Q\d+)-", pic["id"])
    return m.group(1) if m else None


def themes():
    """{Wikidata item: theme} of the downloaded pictures: chosen in the
    preview, or looked up for those downloaded before 4.5 (which carry
    their artist where the theme goes)."""
    try:
        with open(os.path.join(DATA, "themes.json")) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def set_themes(new):
    found = dict(themes(), **new)
    try:
        os.makedirs(DATA, exist_ok=True)
        with open(os.path.join(DATA, "themes.json.new"), "w") as fh:
            json.dump(found, fh, ensure_ascii=False)
        os.replace(os.path.join(DATA, "themes.json.new"), os.path.join(DATA, "themes.json"))
    except OSError:
        pass


def look_up_themes(qids):
    """The themes of these Wikidata items, from their genre or what they
    depict (sections.theme_of)."""
    found = {}
    qids = sorted(qids)
    for k in range(0, len(qids), 50):
        items = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(qids[k:k + 50]),
                               "props": "claims"})["entities"]
        for qid, ent in items.items():
            found[qid] = sections.theme_of(ent.get("claims", {}))
    return found


def remember_picked(path):
    paths = [path] + [p for p in picked() if p != path]
    try:
        os.makedirs(DATA, exist_ok=True)
        with open(os.path.join(DATA, "picked.json"), "w") as fh:
            json.dump(paths[:40], fh, ensure_ascii=False)
    except OSError:
        pass


def find_photos(limit=400):
    """The pictures chosen before, then those in the Pictures folder
    (Изображения), newest first. Nothing else is walked: other places are
    reached through the file chooser, which in a Flatpak is the only way."""
    found = []
    root = PICTURES
    if os.path.isdir(root):
        depth = root.rstrip("/").count("/")
        for top, dirs, files in os.walk(root):
            # Not this program's own folders: their photos are in the
            # gallery already, and the finished pictures are its own.
            dirs[:] = [d for d in dirs if not d.startswith(".")
                       and os.path.join(top, d) not in (PHOTOS, SAVED)
                       and top.count("/") - depth < 4]
            for f in files:
                if f.lower().endswith(IMAGE_TYPES):
                    path = os.path.join(top, f)
                    try:
                        found.append((os.path.getmtime(path), path))
                    except OSError:
                        pass
    found.sort(reverse=True)
    chosen = [p for p in picked() if os.path.isfile(p)]
    return chosen + [p for _t, p in found[:limit] if p not in chosen]


class Workers:
    """A few threads taking jobs in turn (concurrent.futures took a third
    of a second to import on the tablet)."""

    def __init__(self, count):
        self.jobs = queue.Queue()
        for _ in range(count):
            threading.Thread(target=self.work, daemon=True).start()

    def submit(self, fn, *args, cancelled=None):
        self.jobs.put((fn, args, cancelled))

    def work(self):
        while True:
            fn, args, cancelled = self.jobs.get()
            try:
                if cancelled is None or not cancelled.is_set():
                    fn(*args)
            except Exception as exc:  # one job must not stop the thread
                sys.stderr.write("haltia-paint: %s\n" % exc)


# --- the program ------------------------------------------------------------
class Paint:
    def __init__(self, app, open_id=None):
        self.app = app
        self.win = Gtk.ApplicationWindow(application=app, title="Раскраска")
        self.win.set_default_size(1160, 800)
        # The same header as Погода, Новости and MAX: the title in the
        # middle, "←" on the left while a picture is open.
        header = Gtk.HeaderBar()
        self.title = Gtk.Label(label="Раскраски")
        self.title.get_style_context().add_class("title")
        # Downloaded paintings can have long names; the header stays one line.
        self.title.set_ellipsize(Pango.EllipsizeMode.END)
        self.title.set_max_width_chars(36)
        header.set_custom_title(self.title)
        self.back_button = Gtk.Button(label="←")
        self.back_button.get_style_context().add_class("back")
        self.back_button.connect("clicked", lambda _b: self.back())
        self.back_button.set_no_show_all(True)
        header.pack_start(self.back_button)
        self.find_button = Gtk.Button(label="+ Добавить")
        self.find_button.get_style_context().add_class("back")
        self.find_button.connect("clicked", lambda _b: self.add_picture())
        self.find_button.set_no_show_all(True)
        header.pack_end(self.find_button)
        self.settings_button = Gtk.Button(label="⚙")
        self.settings_button.get_style_context().add_class("back")
        self.settings_button.connect("clicked", lambda _b: self.show_settings())
        self.settings_button.set_no_show_all(True)
        header.pack_end(self.settings_button)
        # The shell closes a program with its own ✕; elsewhere the window
        # has the desktop's buttons (its decoration-layout).
        header.set_show_close_button(not ON_HALTIA)
        self.win.set_titlebar(header)
        self.win.connect("destroy", self.quit)
        # Escape and a keyboard's or mouse's "back" do what "←" does.
        self.win.connect("key-press-event", self.on_key)
        self.win.connect("button-press-event", self.on_button)
        # Progress is written a moment after a tap; write it on the way out.
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.quit)
        self.stack = Gtk.Stack()
        # Only the page shown sets how low the window can be: the search
        # page has to fit above the on-screen keyboard (the tablet's 800 px
        # less its 360), while the board alone needs more.
        self.stack.set_vhomogeneous(False)
        self.win.add(self.stack)
        self.board = None
        self.swatches = []
        self.search_page = None
        self.search_gen = 0
        self.search_cancel = threading.Event()
        self.stack.connect("notify::visible-child-name",
                           lambda stack, _prop: self.search_cancel.set()
                           if stack.get_visible_child_name() != "search" else None)
        self.saving = False
        self.preview_item = None
        # Настройки: how the chosen number's regions stand out.
        self.settings = Settings("paint")
        self.highlight = Highlight(self.settings.get("highlight", None),
                                   self.settings.get("highlight-colour", None),
                                   self.settings.get_bool("highlight-invert", False))
        # A picture not begun shows in the gallery in its colours (or pale).
        self.colour_new = self.settings.get_bool("new-in-colour", True)
        # «где?»: shown or not, and how many times a picture (0: no limit).
        self.hint_shown = self.settings.get_bool("hint", True)
        self.hint_limit = self.int_setting("hint-limit", 0, HINT_LIMITS)
        self.hint_zoom = self.int_setting("hint-zoom", HINT_ZOOM, HINT_ZOOMS)
        # How far beside a region of the chosen colour a tap still paints it.
        self.finger = self.int_setting("finger", FINGER, FINGERS)
        # Rings round the last regions of the chosen colour.
        self.rings = self.settings.get_bool("rings", True)
        # A sound and a buzz when a colour or the picture is done; the
        # picture painted again before one's eyes at its end.
        self.feedback = Feedback(SOUNDS, APP_ID, self.settings.get_bool("sound", True),
                                 self.settings.get_bool("vibration", True),
                                 self.settings.get_bool("miss-sound", True),
                                 taps=self.settings.get("tap-buzz", "hit"))
        self.replay = self.settings.get_bool("replay", True)
        # Every button tapped is felt: the shell leaves taps to the program
        # while it is in front (X-Haltia-Own-Feedback), misses unfelt.
        # Seen in every event before GTK takes it (dialogs too), not by a
        # hook on "clicked": that broke GTK's file chooser (4.7.1).
        self.pressed = None  # (the button, x, y) a finger went down on
        Gdk.event_handler_set(self.on_any_event)
        # The kind of picture a preview makes, kept from one to the next.
        self.big_numbers, self.ink = True, 0
        self.pool = Workers(3)
        self.search_pool = Workers(2)
        # pbn.py, one at a time: previews first, then photos (Преобразование).
        self.conversion = Conversion(PBN, notify=GLib.idle_add)
        self.photo_jobs = {}  # photo path -> its job
        # Gallery thumbnails not kept yet are drawn here, one at a time.
        self.thumb_pool = Workers(1)
        self.gallery = None  # kept between visits; built again when stale
        self.gallery_stale = False
        self.cards = {}  # picture id -> [(a card's box, the picture)]
        self.card_states = {}  # picture id -> "new", "begun" or "done"
        self.themes_asked = False
        # The gallery's order: sections.BY_THEME or BY_DIFFICULTY.
        self.gallery_order = self.settings.get("gallery-order", sections.BY_THEME)
        if self.gallery_order not in dict(sections.ORDERS):
            self.gallery_order = sections.BY_THEME
        shutil.rmtree(WORK, ignore_errors=True)
        # An unfinished picture opens straight away; the gallery is built
        # only when it is needed (back() builds it afresh anyway). Building
        # both cost a second before the window first showed.
        open_id = open_id or read_last()
        self.pictures = load_pictures()
        pic = next((p for p in self.pictures[0] if p["id"] == open_id), None)
        if pic:
            done, total = share_done(pic, load_progress(pic))
            if done >= total:
                pic = None
        if not pic or not self.open(pic):
            self.show_gallery()
        self.win.show_all()

    # gallery
    def show_gallery(self, rebuild=False, changed=None):
        """The gallery: built once and kept; a picture closed (changed)
        gets its cards again, or the whole gallery when it moves to
        another section (begun, finished). rebuild: pictures came or went."""
        self.photo_request = None
        self.title.set_text("Раскраски")
        self.back_button.hide()
        self.find_button.show()
        self.settings_button.show()
        if self.gallery and not rebuild:
            if changed in self.cards:
                pic = self.cards[changed][0][1]
                if self.picture_state(pic)[0] != self.card_states.get(changed):
                    rebuild = True
                else:
                    for slot, pic in self.cards[changed]:
                        self.fill_card(slot, pic, slot.note)
            if not rebuild:
                self.stack.set_visible_child_name("gallery")
                self.win.set_focus(None)
                return
        if self.gallery:
            self.stack.remove(self.gallery)
        self.cards = {}
        self.card_states = {}
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
