    def find_themes(self, pictures):
        """Pictures downloaded before 4.5 get their theme from Wikidata,
        once a run, in the background; the gallery is built again then."""
        qids = {wd_qid(p) for p in pictures if wd_qid(p)
                and p.get("theme") not in sections.THEMES}
        if not qids or self.themes_asked:
            return
        self.themes_asked = True

        def work():
            try:
                found = look_up_themes(qids)
            except Exception as exc:  # no network: next time
                sys.stderr.write("haltia-paint: themes: %s\n" % exc)
                return
            set_themes(found)
            GLib.idle_add(self.themes_found)

        threading.Thread(target=work, daemon=True).start()

    def themes_found(self):
        if self.stack.get_visible_child_name() == "gallery":
            self.show_gallery(rebuild=True)
        else:
            self.gallery_stale = True
        return False

    def picture_state(self, pic):
        """("new" | "begun" | "done", when last painted) for the gallery's
        sections."""
        filled = load_progress(pic)
        if not filled:
            return "new", 0
        try:
            when = os.path.getmtime(progress_path(pic))
        except OSError:
            when = 0
        return ("done" if len(filled) >= pic["count"] else "begun"), when

    def order_gallery(self, order):
        """По темам or По сложности, kept in the settings."""
        if order != self.gallery_order:
            self.gallery_order = order
            self.settings.set("gallery-order", order)
            self.show_gallery(rebuild=True)

    def add_cards(self, todo, start, upto, scroll, content):
        for flow, pic, note in todo[start:upto]:
            slot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            self.fill_card(slot, pic, note)
            flow.add(slot)
            slot.get_parent().show_all()
        if start == 0:
            # GTK scrolls to whichever card takes the focus; show the last
            # picture's card instead, or the top.
            GLib.timeout_add(150, self.scroll_to_last, scroll, content)
        if upto < len(todo):
            GLib.idle_add(self.add_cards, todo, upto, upto + 6, scroll, content,
                          priority=GLib.PRIORITY_LOW)
        return False

    def scroll_to_last(self, scroll, content):
        if scroll.get_toplevel() is not self.win:
            return False  # the gallery was built again meanwhile
        last = read_last()
        cards = self.cards.get(last)
        scroll.get_vadjustment().set_value(0)
        # Only when its card is below the first screen (a picture begun is
        # at the top, in Продолжить); a finished one is down in Готовые,
        # and the gallery opens at the top.
        if cards and self.card_states.get(last) != "done":
            slot = cards[0][0]
            pos = slot.translate_coordinates(content, 0, 0)
            page = scroll.get_vadjustment().get_page_size()
            if pos and pos[1] + slot.get_allocated_height() > page:
                self.scroll_to(scroll, content, slot, 70)
        return False

    def scroll_to(self, scroll, content, widget, above):
        """Scroll the gallery so widget shows, above px below the top."""
        pos = widget.translate_coordinates(content, 0, 0)
        if pos:
            scroll.get_vadjustment().set_value(max(0, pos[1] - above))

    def make_photo(self, path):
        """Make a photo into a picture in the background; the gallery
        shows it when it is ready."""
        if path in self.photo_jobs:
            return
        try:
            _pic_id, out = photo_path(path)
        except OSError:
            return
        name = os.path.splitext(os.path.basename(path))[0]
        self.photo_jobs[path] = self.conversion.submit(
            path, out, 3, {"name": name, "level": 9}, flags=["--big-numbers"],
            on_done=lambda _job, ok: self.photo_ready(path, ok))

    def photo_ready(self, path, ok):
        self.photo_jobs.pop(path, None)
        if not ok:
            # Tried again only from its "Ещё раз" button.
            try:
                with open(failed_mark(path), "w"):
                    pass
            except OSError:
                pass
        if self.stack.get_visible_child_name() == "gallery":
            self.show_gallery(rebuild=True)
        else:
            self.gallery_stale = True

    def photo_again(self, path):
        try:
            os.remove(failed_mark(path))
        except OSError:
            pass
        self.show_gallery(rebuild=True)

    def fill_card(self, slot, pic, note):
        """A picture's card in slot (made again when its progress changed):
        its thumbnail, name, the note of its section (sections.sections),
        how far it is, and the buttons to start again or take it out. A
        picture begun has a card in Продолжить and in its own section."""
        for child in slot.get_children():
            slot.remove(child)
        slot.note = note
        cards = self.cards.setdefault(pic["id"], [])
        if not any(s is slot for s, _p in cards):
            cards.append((slot, pic))
        filled = load_progress(pic)
        done, total = share_done(pic, filled)
        self.card_states[pic["id"]] = "new" if not done else ("done" if done >= total else "begun")
        # The thumbnail takes what room the card has: the cards of a
        # section are as high as its highest (one begun has a bar and a
        # button more), and a fixed one left the others empty below.
        thumb = Gtk.DrawingArea()
        thumb.set_size_request(320, 220)
        # Each card its own: a picture begun has two (Продолжить and its
        # section), and one shared by id let the second card's making drop
        # the first one's, left pale.
        shown = {}
        asked = []

        def draw(widget, cr):
            w, h = widget.get_allocated_width(), widget.get_allocated_height()
            image = shown.get("image")
            if image is None:
                # Kept as PNG most of the time; else drawn in a thread
                # while a pale square stands in.
                cr.set_source_rgb(0.93, 0.93, 0.92)
                cr.rectangle(w * 0.1, h * 0.05, w * 0.8, h * 0.9)
                cr.fill()
                if not asked:
                    asked.append(True)
                    self.thumb_pool.submit(self.make_thumb, pic, filled, done == total, widget,
                                           shown)
                return False
            iw, ih = image.get_width(), image.get_height()
            k = min(w / iw, h / ih, 1.25)
            cr.translate((w - iw * k) / 2, (h - ih * k) / 2)
            cr.scale(k, k)
            cr.set_source_surface(image, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_GOOD)
            cr.paint()
            return False

        thumb.connect("draw", draw)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        inner.pack_start(thumb, True, True, 0)
        name = Gtk.Label(label=pic["name"])
        name.set_line_wrap(True)
        name.set_justify(Gtk.Justification.CENTER)
        name.set_max_width_chars(18)
        inner.pack_start(name, False, False, 0)
        if note:
            line = Gtk.Label(label=note)
            line.get_style_context().add_class("progress")
            inner.pack_start(line, False, False, 0)
        # How far it is: nothing when new, a bar when begun, a tick when done.
        if done >= total:
            tick = Gtk.Label(label="✓ Готово")
            tick.get_style_context().add_class("done")
            inner.pack_start(tick, False, False, 0)
        elif done:
            row = Gtk.Box(spacing=12)
            bar = Gtk.ProgressBar()
            bar.set_fraction(done / total)
            bar.set_valign(Gtk.Align.CENTER)
            row.pack_start(bar, True, True, 0)
            share = Gtk.Label(label="%d %%" % (100 * done // total))
            share.get_style_context().add_class("progress")
            row.pack_start(share, False, False, 0)
            inner.pack_start(row, False, False, 0)
        button = Gtk.Button()
        button.get_style_context().add_class("card")
        button.add(inner)
        button.connect("clicked", lambda _b: self.open(pic))
        slot.pack_start(button, True, True, 0)
        if done:
            # A started or finished picture can be wiped and begun again.
            reset = Gtk.Button(label="↺  Начать заново")
            reset.get_style_context().add_class("reset")
            reset.connect("clicked", lambda _b: self.reset(pic))
            slot.pack_start(reset, False, False, 0)
        if pic["id"].startswith("wd-"):
            remove = Gtk.Button(label="✕  Убрать")
            remove.get_style_context().add_class("reset")
            remove.connect("clicked", lambda _b: self.remove(pic))
            slot.pack_start(remove, False, False, 0)
        slot.show_all()

    def make_thumb(self, pic, filled, finished, widget, shown):
        """In the thumbnail thread: the thumbnail, then shown in its card
        (shown is the card's)."""
        try:
            image = thumbnail(pic, filled, finished, self.colour_new)
        except Exception as exc:  # a broken file must not stop the thread
            sys.stderr.write("haltia-paint: %s: %s\n" % (pic["id"], exc))
            return

        def show():
            shown["image"] = image
            widget.queue_draw()
            return False

        GLib.idle_add(show)

    def remove(self, pic):
        """Take a downloaded picture out of the gallery, with its progress."""
        if not self.confirm("Убрать «%s»\nиз раскрасок?" % pic["name"], "Убрать"):
            return
        for path in (pic["path"], progress_path(pic),
                     os.path.join(DATA, "thumbs", pic["id"] + ".png")):
            try:
                os.remove(path)
            except OSError:
                pass
        # Its painting too, when no other kind of it is left.
        key = pic["id"][3:].rsplit("-", 1)[0]
        if not downloaded_any(key):
            try:
                os.remove(downloaded_original(key))
            except OSError:
                pass
        self.show_gallery(rebuild=True)

    def reset(self, pic):
        if not self.confirm("Начать «%s» заново?\nВсё раскрашенное сотрётся." % pic["name"],
                            "Начать заново"):
            return
        for path in (progress_path(pic), os.path.join(DATA, "thumbs", pic["id"] + ".png")):
            try:
                os.remove(path)
            except OSError:
                pass
        write_last(pic["id"])
        self.show_gallery(changed=pic["id"])

    def confirm(self, question, yes):
        """A yes/no question in the window; Отмена is the default. Both
        questions asked so lose something, so the yes button is red."""
        def redden():
            for win in Gtk.Window.list_toplevels():
                if isinstance(win, Gtk.Dialog) and win.get_transient_for() is self.win:
                    button = win.get_widget_for_response(Gtk.ResponseType.OK)
                    if button:
                        button.get_style_context().add_class("destructive-action")
                        button.get_style_context().add_class("danger")
            return False

        # haltia_kit's dialog runs a loop of its own: marked once it shows.
        GLib.idle_add(redden)
        return dialogs.ask(self.win, question, yes)

