            row.set_margin_end(20)
            row.set_margin_top(12)
            note = Gtk.Label(label="Не получилось сделать картину из «%s»"
                             % os.path.splitext(os.path.basename(path))[0], xalign=0)
            note.get_style_context().add_class("note")
            note.set_line_wrap(True)
            row.pack_start(note, True, True, 0)
