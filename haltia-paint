            again.connect("clicked", lambda _b, p=path: self.photo_again(p))
            row.pack_start(again, False, False, 0)
            content.pack_start(row, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        todo = []
        # Продолжить and Готовые stand out in colour, their buttons beside
