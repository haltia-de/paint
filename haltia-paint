    def choice(self, box, heading, options, key, current, keep):
        """A row of buttons in Настройки, one of options [(value, name)]:
        the one tapped is on, kept as key at once and given to keep."""
        label = Gtk.Label(label=heading, xalign=0)
        label.get_style_context().add_class("pinfo")
        box.pack_start(label, False, False, 0)
        row = Gtk.Box(spacing=14)
        buttons = []

        def show(value):
            for b, v in buttons:
                (b.get_style_context().add_class if v == value
                 else b.get_style_context().remove_class)("on")

        def chosen(value):
            self.settings.set(key, value if isinstance(value, bool) else str(value))
            keep(value)
            show(value)

        for value, name in options:
            b = Gtk.Button(label=name)
            b.get_style_context().add_class("grade")
            b.connect("clicked", lambda _b, v=value: chosen(v))
            row.pack_start(b, False, False, 0)
            buttons.append((b, value))
        box.pack_start(row, False, False, 0)
        show(current)

    def draw_look(self, widget, cr, key, value):
        """A sample of a choice: a patch of it with a number on it, as the
        board will show it (the other choice as it is now)."""
        look = Highlight(value if key == "style" else self.highlight.style,
                         value if key == "colour" else self.highlight.colour,
                         self.highlight.inverted)
        w, h = widget.get_allocated_width(), widget.get_allocated_height()
        cr.set_source_rgb(0.9, 0.9, 0.89)
        cr.paint()
        cr.rectangle(8, 8, w - 16, h - 16)
        cr.set_source(look.mark((0.59, 0.64, 0.54)).source(1.0))
        cr.fill_preserve()
        cr.set_source_rgb(0.55, 0.55, 0.58)
        cr.set_line_width(1)
        cr.stroke()
        text, halo = look.number
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(34)
        ext = cr.text_extents("6")
        cr.move_to(w / 2 - ext.width / 2 - ext.x_bearing, h / 2 - ext.height / 2 - ext.y_bearing)
        cr.text_path("6")
        cr.set_source_rgb(*halo)
        cr.set_line_width(6)
        cr.stroke_preserve()
        cr.set_source_rgb(*text)
        cr.fill()
        return False

    def choose_look(self, key, value):
        """A choice tapped (None: just show which are chosen), kept in the
        settings at once."""
        if key == "style":
            self.settings.set("highlight", value)
        elif key == "colour":
            self.settings.set("highlight-colour", value)
        if key:
            self.highlight = Highlight(value if key == "style" else self.highlight.style,
                                       value if key == "colour" else self.highlight.colour,
                                       value if key == "invert" else self.highlight.inverted)
        for b, k, v, sample in self.look_buttons:
            on = v == (self.highlight.style if k == "style" else self.highlight.colour)
            (b.get_style_context().add_class if on else b.get_style_context().remove_class)("on")
            sample.queue_draw()
        self.choose_new(None)

    def choose_new(self, on):
        """How pictures not begun show in the gallery (None: just show
        which is chosen)."""
        if on is not None and on != self.colour_new:
            self.colour_new = on
            self.settings.set("new-in-colour", on)
            self.gallery_stale = True
        for b, v in self.new_buttons:
            (b.get_style_context().add_class if v == self.colour_new
             else b.get_style_context().remove_class)("on")

    def on_key(self, _win, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_Back) or (
                event.keyval == Gdk.KEY_Left and event.state & Gdk.ModifierType.MOD1_MASK):
            if self.back_button.get_visible():
                self.back()
                return True
        return False

    def on_button(self, _win, event):
        # The side button of a mouse that means "back".
        if event.button == 8 and self.back_button.get_visible():
            self.back()
            return True
        return False

    def back(self):
        if self.stack.get_visible_child_name() == "settings" and self.settings_from == "board":
            self.back_to_board()
            return
        if self.stack.get_visible_child_name() == "settings":
            stale, self.gallery_stale = self.gallery_stale, False
            self.show_gallery(rebuild=stale)
            return
        if self.stack.get_visible_child_name() == "preview":
            if self.preview_item and self.preview_item.get("own"):
                self.show_photos()
            else:
                self.show_search()
            return
        self.save()
        changed = None
        if self.board:
            self.board.stop()
            changed = self.board.pic["id"]
        self.board = None
        stale, self.gallery_stale = self.gallery_stale, False
        self.show_gallery(rebuild=stale, changed=changed)

    def back_to_board(self):
        """From Настройки to the picture being painted, as it was: its
        highlight drawn again, «где?» shown or not, its count anew."""
        b = self.board
        self.back_button.show()
        self.find_button.hide()
        self.settings_button.show()
        self.stack.set_visible_child_name("board")
        self.refresh_swatches()  # the header's name and share
        if not b.finished:
            self.find_tool.set_visible(self.hint_shown)
            self.hints_shown()
        # Tiles of the new highlight: all drawn again.
        b.base = None
        b.tiles.clear()  # not stretched in meanwhile: they have the old one
        b.set_scale(b.scale)

    def save(self):
        if self.board:
            self.board.save_now()

    def quit(self, *_args):
        self.save()
        self.conversion.stop()
        self.app.quit()
        return False


class App(Gtk.Application):
    """One window: starting the program again shows the one there is."""

    def __init__(self, open_id=None):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.open_id = open_id
        self.paint = None

    def do_activate(self):
        if self.paint:
            self.paint.win.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        move_photos()
        try:
            os.makedirs(PHOTOS, exist_ok=True)
        except OSError:  # a sandbox without the home folder
            pass
        self.paint = Paint(self, self.open_id)


def main():
    # --open ID goes straight to one picture (for testing).
    open_id = sys.argv[2] if sys.argv[1:2] == ["--open"] and len(sys.argv) > 2 else None
    # The folders of versions before 4.0, b8k-paint: the pictures made,
    # the progress and the thumbnails move to the new name once.
    paths.migrate_dirs("b8k-paint", "haltia-paint")
    return App(open_id).run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
