SVG = "{http://www.w3.org/2000/svg}"


# What the gallery needs of each picture file, kept by path with its size
# and time (reading the head of a hundred gzipped files took 0.7 s).
_HEADS = None


def heads(save=False):
    """The kept heads; with save, write them out if they changed."""
    global _HEADS
    path = os.path.join(DATA, "heads.json")
    if _HEADS is None:
        try:
            with open(path) as fh:
                _HEADS = json.load(fh)
        except (OSError, ValueError):
            _HEADS = {}
        _HEADS[""] = False  # changed
    if save and _HEADS.get(""):
        _HEADS[""] = False
        try:
            os.makedirs(DATA, exist_ok=True)
            with open(path + ".new", "w") as fh:
                json.dump(_HEADS, fh, ensure_ascii=False)
            os.replace(path + ".new", path)
        except OSError:
            pass
    return _HEADS


def picture_at(path, pic_id):
    """A picture file's description, read without its regions; None when
    it cannot be read."""
    try:
        st = os.stat(path)
        stamp = [st.st_mtime, st.st_size]
        kept = heads().get(path)
        if kept and kept[0] == stamp:
            head = kept[1]
        else:
            with gzip.open(path) as fh:
                head = dict(next(ET.iterparse(fh, events=("start",)))[1].attrib)
            head.pop("data-source", None)
            heads()[path] = [stamp, head]
            heads()[""] = True
        return {"id": pic_id, "path": path,
                "name": head.get("data-name") or os.path.splitext(os.path.basename(path))[0],
                "theme": head.get("data-theme", ""), "level": int(head.get("data-level", 9)),
                "w": float(head["width"]), "h": float(head["height"]),
                "palette": head["data-palette"].split(), "count": int(head["data-count"]),
                "sig": head.get("data-sig"), "mode": head.get("data-mode", "").split(),
                "mtime": st.st_mtime}
    except (OSError, ET.ParseError, StopIteration, KeyError, ValueError):
        return None


class Region:
    """n: the colour number from 0; x, y, r: where the number goes and how
    far the region reaches around it; path: its outline as a cairo path;
    box: (x0, y0, x1, y1)."""
    __slots__ = ("n", "x", "y", "r", "path", "box")


def regions_of(pic):
    """Read regions atomically; report damaged picture data as an I/O error."""
    try:
        return read_regions(pic)
    except (EOFError, ET.ParseError, ValueError, TypeError, AttributeError,
            IndexError, KeyError, cairo.Error) as exc:
        raise OSError("invalid picture regions: %s" % exc) from exc


def read_regions(pic):
    """The regions, read only when a picture is drawn, and a grid of the
    regions whose box meets each GRID-unit square; the picture's own
    outlines (pbn.py --ink), if it has them, in pic["ink"]."""
    if "regions" not in pic:
        with gzip.open(pic["path"]) as fh:
            root = ET.fromstring(fh.read())
        cr = cairo.Context(cairo.ImageSurface(cairo.FORMAT_A8, 1, 1))
        regions, grid, ink = [], {}, []
        for el in root.iter(SVG + "path"):
            cr.new_path()
            for ring in el.get("d").split("M")[1:]:
                v = [float(t) for t in ring.rstrip("Z").split()]
                if len(v) % 2 or not all(math.isfinite(t) for t in v):
                    raise ValueError("invalid region outline")
                if len(v) < 6:
                    continue
                cr.move_to(v[0], v[1])
                for i in range(2, len(v), 2):
                    cr.line_to(v[i], v[i + 1])
                cr.close_path()
            if el.get("data-ink"):
                ink.append(cr.copy_path())
                continue
            reg = Region()
            reg.n = int(el.get("data-n")) - 1
            if not 0 <= reg.n < len(pic["palette"]):
                raise ValueError("invalid colour number")
            reg.x, reg.y, reg.r = map(float, el.get("data-label").split())
            if not all(math.isfinite(v) for v in (reg.x, reg.y, reg.r)) or reg.r < 0:
                raise ValueError("invalid number position")
            reg.path = cr.copy_path()
            reg.box = x0, y0, x1, y1 = cr.path_extents()
            for gx in range(int(x0 // GRID), int(x1 // GRID) + 1):
                for gy in range(int(y0 // GRID), int(y1 // GRID) + 1):
                    grid.setdefault((gx, gy), []).append(len(regions))
            regions.append(reg)
        if len(regions) != pic["count"] or not regions:
            raise ValueError("invalid region count")
        if ink:
            # All the outlines as one path, filled at once.
            cr.new_path()
            for part in ink:
                cr.append_path(part)
            ink = cr.copy_path()
        pic["regions"], pic["grid"], pic["ink"] = regions, grid, ink or None
    return pic["regions"]


def without_regions(pic):
    """The picture's description without what regions_of read."""
    return {k: v for k, v in pic.items() if k not in ("regions", "grid", "ink")}


def drop_regions(pic):
    """Forget what regions_of read (it is read again when needed)."""
    for key in ("regions", "grid", "ink"):
        pic.pop(key, None)


def regions_in(pic, x0, y0, x1, y1):
    """The regions whose box meets this rectangle (picture units)."""
    regions = regions_of(pic)
    grid = pic["grid"]
    found = set()
    for gx in range(int(x0 // GRID), int(x1 // GRID) + 1):
        for gy in range(int(y0 // GRID), int(y1 // GRID) + 1):
            found.update(grid.get((gx, gy), ()))
    return sorted(i for i in found if regions[i].box[0] <= x1 and regions[i].box[2] >= x0
                  and regions[i].box[1] <= y1 and regions[i].box[3] >= y0)


def read_download(req, limit, cancelled=None):
    """Bound the whole transfer, including a server trickling bytes."""
    import urllib.request
    deadline = time.monotonic() + 60
    with urllib.request.urlopen(req, timeout=20) as fh:
        chunks, size = [], 0
        while size < limit:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("download deadline exceeded")
            if cancelled is not None and cancelled.is_set():
                raise OSError("download cancelled")
            # HTTPResponse.read1 makes at most one socket read. Set its
            # timeout to the remaining budget, rather than per-byte activity.
            fh.fp.raw._sock.settimeout(min(remaining, 20))
            chunk = fh.read1(min(65536, limit - size))
            if time.monotonic() >= deadline:
                raise TimeoutError("download deadline exceeded")
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
        return b"".join(chunks), fh.geturl()


def api(url, params):
    params = dict(params, format="json", formatversion="2")
    import urllib.parse  # only for searching: a fifth of a second at start
    import urllib.request
    req = urllib.request.Request(url + "?" + urllib.parse.urlencode(params),
                                 headers={"User-Agent": AGENT})
    return json.loads(read_download(req, 4_000_000)[0])


def fetch_image(url, cancelled=None):
    """Image bytes, only over https from the Wikimedia image hosts."""
    import urllib.parse
    import urllib.request

    def allowed(u):
        parts = urllib.parse.urlsplit(u)
        return parts.scheme == "https" and parts.hostname in IMAGE_HOSTS
    if not allowed(url):
        raise ValueError("not a Wikimedia image: %r" % url)
    req = urllib.request.Request(url, headers={"User-Agent": AGENT})
    data, final_url = read_download(req, 8_000_000, cancelled)
    if not allowed(final_url):
        raise ValueError("redirected away: %r" % final_url)
    return data


def label_of(entity):
    labels = entity.get("labels", {})
    for lang in ("ru", "en"):
        if lang in labels:
            return labels[lang]["value"]
    return ""


def claim(entity, prop):
    """The first value of a statement, or None."""
    for st in entity.get("claims", {}).get(prop, []):
        snak = st.get("mainsnak", {})
        if snak.get("snaktype") == "value":
            return snak.get("datavalue", {}).get("value")
    return None


def image_info(files, width):
    """{Commons file name: (thumbnail url, licence)} at that width."""
    if not files:
        return {}
    data = api(COMMONS, {"action": "query", "prop": "imageinfo", "iiprop": "url|extmetadata",
                         "iiurlwidth": width, "iiextmetadatafilter": "LicenseShortName",
                         "titles": "|".join("File:" + f for f in files)})["query"]
    # The API answers with titles normalized (underscores, first letter).
    back = {n["to"]: n["from"] for n in data.get("normalized", [])}
    found = {}
    for page in data.get("pages", []):
        info = (page.get("imageinfo") or [{}])[0]
        url = info.get("thumburl") or info.get("url")
        if not url:
            continue
        title = back.get(page["title"], page["title"])
        licence = info.get("extmetadata", {}).get("LicenseShortName", {}).get("value", "")
        found[title[len("File:"):]] = (url, licence)
    return found


def painting_query(text):
    """The Wikidata search for what one typed: the works of an artist
    when it names one (their label or an alias, "Хокусай" included), as a
    painting's own label rarely names its artist; otherwise paintings
    whose title or description has those words."""
    kinds = "haswbstatement:P31=%s haswbstatement:P18" % "|P31=".join(KINDS)
    found = api(WIKIDATA, {"action": "wbsearchentities", "search": text, "language": "ru",
                           "uselang": "ru", "type": "item", "limit": 5})["search"]
    ids = [f["id"] for f in found if re.fullmatch(r"Q\d+", f.get("id", ""))]
    if ids:
        people = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(ids),
                                "props": "claims"})["entities"]
        for qid in ids:
            jobs = people.get(qid, {}).get("claims", {}).get("P106", [])
            if any(j.get("mainsnak", {}).get("datavalue", {}).get("value", {}).get("id")
                   in ARTISTS for j in jobs):
                return "haswbstatement:P170=%s %s" % (qid, kinds)
    return "%s %s" % (text, kinds)


def search_paintings(query, offset=0):
    """Paintings for a painting_query(): a list of dicts, and the offset
    of the next page (None at the end)."""
    data = api(WIKIDATA, {"action": "query", "list": "search", "srnamespace": 0,
                          "srsearch": query, "srlimit": PAGE, "sroffset": offset, "srprop": "",
                          # Russian words are matched by their stems only so.
                          "uselang": "ru"})
    ids = [s["title"] for s in data["query"]["search"] if re.fullmatch(r"Q\d+", s["title"])]
    more = data.get("continue", {}).get("sroffset")
    if not ids:
        return [], None
    items = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(ids),
                           "props": "labels|claims", "languages": "ru|en"})["entities"]
    found = []
    for qid in ids:
        ent = items.get(qid, {})
        image = claim(ent, "P18")
        if not isinstance(image, str):
            continue
        creator = claim(ent, "P170")
        made = claim(ent, "P571")
        year = re.match(r"[+-](\d+)-", made.get("time", "")) if isinstance(made, dict) else None
        found.append({"qid": qid, "file": image, "year": int(year.group(1)) if year else None,
                      "title": label_of(ent) or os.path.splitext(image)[0],
                      "theme": sections.theme_of(ent.get("claims", {})),
                      "creator": creator.get("id") if isinstance(creator, dict) else None})
    who = sorted({f["creator"] for f in found if f["creator"]})
    names = {}
    if who:
        people = api(WIKIDATA, {"action": "wbgetentities", "ids": "|".join(who),
                                "props": "labels", "languages": "ru|en"})["entities"]
        names = {k: label_of(v) for k, v in people.items()}
    thumbs = image_info([f["file"] for f in found], THUMB)
    for f in found:
        f["author"] = names.get(f["creator"], "")
        f["thumb"] = thumbs.get(f["file"], ("", ""))[0]
    return [f for f in found if f["thumb"]], more


# A 48 MP camera photo fits; larger input is rejected before pixel allocation.
MAX_IMAGE_PIXELS = 64_000_000


def check_png_header(data):
    """Reject oversized PNGs before gdk-pixbuf allocates their pixels."""
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        if len(data) < 24 or data[12:16] != b"IHDR":
            raise OSError("invalid PNG header")
        w = int.from_bytes(data[16:20], "big")
        h = int.from_bytes(data[20:24], "big")
        if not w or not h or w * h > MAX_IMAGE_PIXELS:
            raise OSError("too many image pixels")


def pixbuf_file(path, width, height):
    """Decode a local image at display size, with a cap on source pixels."""
    with open(path, "rb") as fh:
        check_png_header(fh.read(24))
    info = GdkPixbuf.Pixbuf.get_file_info(path)
    if not info or not info[0] or not 0 < info[1] * info[2] <= MAX_IMAGE_PIXELS:
        raise OSError("invalid image or too many image pixels")
    return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, width, height, True).apply_embedded_orientation()


def pixbuf_of(data, width, height):
    """Image bytes decoded to fit width x height, with bounded pixels."""
    check_png_header(data)
    loader = GdkPixbuf.PixbufLoader()
    oversized = []

    def prepared(loader, w, h):
        if not 0 < w * h <= MAX_IMAGE_PIXELS:
            oversized.append(True)
            loader.set_size(1, 1)
        else:
            scale = min(width / w, height / h)
            loader.set_size(max(1, int(w * scale)), max(1, int(h * scale)))

    loader.connect("size-prepared", prepared)
    loader.write(data)
    loader.close()
    if oversized:
        raise OSError("too many image pixels")
    return loader.get_pixbuf().apply_embedded_orientation()


def kind_name(kind):
    """A preview's kind of picture, (level, big numbers, outlines 0/1/2),
    as it ends a file or id: "3", "3b", "4bk", "4bkk" (pictures before
    4.3 have only the level)."""
    level, big, ink = kind
    return "%d%s%s" % (level, "b" if big else "", "k" * ink)


def kind_flags(kind):
    _level, big, ink = kind
    return ((["--big-numbers"] if big else [])
            + {0: [], 1: ["--ink"], 2: ["--more-ink"]}[ink])


