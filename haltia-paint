def photo_path(path):
    """Where a photo's picture is kept: (id, file), new when the photo is."""
    st = os.stat(path)
    key = hashlib.sha1(("pbn|%s|%d|%d" % (path, st.st_size, st.st_mtime)).encode()).hexdigest()[:16]
    return "photo-" + key, os.path.join(DATA, "photos", key + ".svgz")


def failed_mark(path):
    """The file that says a photo could not be made into a picture."""
    return photo_path(path)[1][:-len(".svgz")] + ".failed"


def photo_failed(path):
