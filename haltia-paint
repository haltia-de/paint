    def choose_file(self):
        """A picture from anywhere, through the desktop's own file chooser
        (the portal in a Flatpak or KDE, GTK's dialog elsewhere)."""
        chooser = Gtk.FileChooserNative.new("Выбрать картинку", self.win,
                                            Gtk.FileChooserAction.OPEN, "Выбрать", "Отмена")
        kinds = Gtk.FileFilter()
        kinds.set_name("Картинки")
        for kind in ("image/jpeg", "image/png", "image/webp"):
            kinds.add_mime_type(kind)
        chooser.add_filter(kinds)
        if os.path.isdir(PICTURES):
            chooser.set_current_folder(PICTURES)
        chooser.connect("response", self.file_chosen)
        self.chooser = chooser  # kept while it is shown
        chooser.show()

    def file_chosen(self, chooser, response):
        path = chooser.get_filename() if response == Gtk.ResponseType.ACCEPT else None
        self.chooser = None
        if not path:
            return
        remember_picked(path)
        if path not in getattr(self, "photo_paths", [path]):
            self.photo_paths.insert(0, path)
            card = self.photo_card(path)
            self.photo_grid.insert(card, 0)
            card.show_all()
        self.photo_chosen(path)

    def photo_chosen(self, path):
        self.photo_request = request = object()
        page = self.stack.get_visible_child()

        def loaded(item):
            if self.photo_request is request and self.stack.get_visible_child() is page:
                if item is None:
                    dialogs.info(self.win, "Эту картинку не открыть.")
                else:
                    self.show_preview(item)
            return False

        def work():
            try:
                st = os.stat(path)
                if st.st_size > 40_000_000:
                    raise OSError("too large")
                large = pixbuf_file(path, 640, 520)
                with open(path, "rb") as fh:
                    data = fh.read(40_000_001)
                if len(data) > 40_000_000:
                    raise OSError("too large")
                key = hashlib.sha1(("%s|%d|%d" % (path, st.st_size, st.st_mtime)).encode()).hexdigest()
                item = {"qid": "own-" + key[:12],
                        "title": os.path.splitext(os.path.basename(path))[0],
                        "author": "", "year": None, "file": path, "data": data,
                        "theme": sections.MY_PHOTOS, "large": large, "own": True}
            except (OSError, GLib.Error) as exc:
                sys.stderr.write("haltia-paint: %s: %s\n" % (path, exc))
                item = None
            GLib.idle_add(loaded, item)

        self.pool.submit(work)

