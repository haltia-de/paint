class Paint:
    def __init__(self, app, open_id=None):
        self.app = app
        self.win = Gtk.ApplicationWindow(application=app, title="Раскраска")
        self.win.set_default_size(1160, 800)
        # The same header as Погода, Новости and MAX: the title in the
        # middle, "←" on the left while a picture is open.
        header = Gtk.HeaderBar()
        self.title = Gtk.Label(label="Раскраски")
        self.title.get_style_context().add_class("title")
        # Downloaded paintings can have long names; the header stays one line.
        self.title.set_ellipsize(Pango.EllipsizeMode.END)
        self.title.set_max_width_chars(36)
        header.set_custom_title(self.title)
        self.back_button = Gtk.Button(label="←")
        self.back_button.get_style_context().add_class("back")
        self.back_button.connect("clicked", lambda _b: self.back())
        self.back_button.set_no_show_all(True)
        header.pack_start(self.back_button)
        self.find_button = Gtk.Button(label="+ Добавить")
        self.find_button.get_style_context().add_class("back")
        self.find_button.connect("clicked", lambda _b: self.add_picture())
        self.find_button.set_no_show_all(True)
        header.pack_end(self.find_button)
        self.win.set_titlebar(header)
        self.win.connect("destroy", self.quit)
        # Progress is written a moment after a tap; write it on the way out.
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.quit)
        self.stack = Gtk.Stack()
        self.win.add(self.stack)
        self.board = None
        self.swatches = []
        self.search_page = None
        self.search_gen = 0
        self.preview_item = None
        self.pool = Workers(3)
        # Photos being made into pictures, one at a time.
        self.photo_jobs = set()
        self.photo_pool = Workers(1)
        # Gallery thumbnails not kept yet are drawn here, one at a time.
        self.thumb_pool = Workers(1)
        self.thumbs = {}  # picture id -> its thumbnail surface
        self.gallery = None  # kept between visits; built again when stale
        self.gallery_stale = False
        self.cards = {}  # picture id -> (the card's box, the picture)
        shutil.rmtree(WORK, ignore_errors=True)
        # An unfinished picture opens straight away; the gallery is built
        # only when it is needed (back() builds it afresh anyway). Building
        # both cost a second before the window first showed.
        open_id = open_id or read_last()
        self.pictures = load_pictures()
        pic = next((p for p in self.pictures[0] if p["id"] == open_id), None)
        if pic:
            done, total = share_done(pic, load_progress(pic))
            if done >= total:
                pic = None
        if pic:
            self.open(pic)
        else:
            self.show_gallery()
        self.win.show_all()

    # gallery
    def show_gallery(self, rebuild=False, changed=None):
        """The gallery: built once and kept; a picture closed (changed)
        gets its card again. rebuild: pictures came or went."""
        self.title.set_text("Раскраски")
        self.back_button.hide()
        self.find_button.show()
        if self.gallery and not rebuild:
            if changed in self.cards:
                self.fill_card(*self.cards[changed])
            self.stack.set_visible_child_name("gallery")
            self.win.set_focus(None)
            return
        if self.gallery:
            self.stack.remove(self.gallery)
        self.cards = {}
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        # One section per level, easier at the top.
        sections = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pictures, waiting = self.pictures if self.pictures else load_pictures()
        self.pictures = None
        for path in waiting:
            self.make_photo(path)
        own = {key for key, _heading in SECTIONS if isinstance(key, str)}
        todo = []
        for key, heading in SECTIONS:
            # By level and theme; downloaded ones newest first.
            pics = sorted((p for p in pictures
                           if (p.get("theme") == key if key in own
                               else p.get("level") == key and p.get("theme") not in own)),
                          key=lambda p: (p.get("level", 0),
                                         THEMES.index(p["theme"]) if p.get("theme") in THEMES
                                         else len(THEMES),
                                         -p.get("mtime", 0) if key == 8 else 0))
            if not pics:
                continue
            label = Gtk.Label(label=heading, xalign=0)
            label.get_style_context().add_class("section")
            sections.pack_start(label, False, False, 0)
            flow = Gtk.FlowBox()
            flow.set_selection_mode(Gtk.SelectionMode.NONE)
            flow.set_homogeneous(True)
            flow.set_max_children_per_line(3)
            flow.set_min_children_per_line(3)
            flow.set_row_spacing(16)
            flow.set_column_spacing(16)
            flow.set_margin_start(16)
            flow.set_margin_end(16)
            flow.set_margin_bottom(8)
            sections.pack_start(flow, False, False, 0)
            todo += [(flow, pic) for pic in pics]
        if waiting:
            note = Gtk.Label(label="Готовлю раскраски из фотографий: %d. Это займёт "
                                   "около полуминуты на каждую." % len(waiting), xalign=0)
            note.get_style_context().add_class("note")
            note.set_line_wrap(True)
            note.set_margin_start(20)
            sections.pack_start(note, False, False, 0)
        if not pictures and not waiting:
            sections.pack_start(Gtk.Label(label="Нет картинок"), True, True, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_kinetic_scrolling(True)
        scroll.add(sections)
        box.pack_start(scroll, True, True, 0)
        box.show_all()
        self.gallery = box
        self.stack.add_named(box, "gallery")
        self.stack.set_visible_child_name("gallery")
        self.win.set_focus(None)
        # The first screenful at once, the rest a few cards at a time while
        # the gallery already shows (a hundred cards took a second).
        last = read_last()
        first = next((k for k, (_f, p) in enumerate(todo) if p["id"] == last), 0)
        self.add_cards(todo, 0, max(9, first + 9), scroll, sections)

    def add_cards(self, todo, start, upto, scroll, sections):
        for flow, pic in todo[start:upto]:
            slot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            self.fill_card(slot, pic)
            flow.add(slot)
            slot.get_parent().show_all()
        if start == 0:
            # GTK scrolls to whichever card takes the focus; show the last
            # picture's card instead, or the top.
            GLib.timeout_add(150, self.scroll_to_last, scroll, sections)
        if upto < len(todo):
            GLib.idle_add(self.add_cards, todo, upto, upto + 6, scroll, sections,
                          priority=GLib.PRIORITY_LOW)
        return False

    def scroll_to_last(self, scroll, sections):
        y = 0
        card = self.cards.get(read_last())
        if card:
            pos = card[0].translate_coordinates(sections, 0, 0)
            if pos:
                y = max(0, pos[1] - 70)
        scroll.get_vadjustment().set_value(y)
        return False

    def make_photo(self, path):
        """Make a photo into a picture in the background; the gallery
        shows it when it is ready."""
        if path in self.photo_jobs:
            return
        self.photo_jobs.add(path)

        def work():
            try:
                _pic_id, out = photo_path(path)
                os.makedirs(os.path.dirname(out), exist_ok=True)
                name = os.path.splitext(os.path.basename(path))[0]
                if not make_picture(path, out, 3, {"name": name, "level": 9}):
                    return
            except OSError:
                return
            GLib.idle_add(self.photo_ready, path)

        self.photo_pool.submit(work)

    def photo_ready(self, path):
        self.photo_jobs.discard(path)
        if self.stack.get_visible_child_name() == "gallery":
            self.show_gallery(rebuild=True)
        else:
            self.gallery_stale = True
        return False

    def fill_card(self, slot, pic):
        """A picture's card in slot (made again when its progress changed):
        its thumbnail, name, theme, how far it is, and the buttons to start
        again or take it out."""
        for child in slot.get_children():
            slot.remove(child)
        self.cards[pic["id"]] = (slot, pic)
        filled = load_progress(pic)
        done, total = share_done(pic, filled)
        thumb = Gtk.DrawingArea()
        tw, th = 320, 220
        thumb.set_size_request(tw, th)
        self.thumbs.pop(pic["id"], None)
        asked = []

        def draw(widget, cr):
            image = self.thumbs.get(pic["id"])
            if image is None:
                # Kept as PNG most of the time; else drawn in a thread
                # while a pale square stands in.
                cr.set_source_rgb(0.93, 0.93, 0.92)
                cr.rectangle(30, 10, tw - 60, th - 20)
                cr.fill()
                if not asked:
                    asked.append(True)
                    self.thumb_pool.submit(self.make_thumb, pic, filled, done == total, widget)
                return False
            cr.set_source_surface(image, (tw - image.get_width()) // 2,
                                  (th - image.get_height()) // 2)
            cr.paint()
            return False

        thumb.connect("draw", draw)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        inner.pack_start(thumb, False, False, 0)
        name = Gtk.Label(label=pic["name"])
        name.set_line_wrap(True)
        name.set_justify(Gtk.Justification.CENTER)
        name.set_max_width_chars(18)
        inner.pack_start(name, False, False, 0)
        if pic.get("theme"):
            theme = Gtk.Label(label=pic["theme"])
            theme.get_style_context().add_class("progress")
            inner.pack_start(theme, False, False, 0)
        state = "Готово" if done == total else ("%d%%" % (100 * done // total) if done else "Новая")
        prog = Gtk.Label(label=state)
        prog.get_style_context().add_class("progress")
        inner.pack_start(prog, False, False, 0)
        button = Gtk.Button()
        button.get_style_context().add_class("card")
        button.add(inner)
        button.connect("clicked", lambda _b: self.open(pic))
        slot.pack_start(button, True, True, 0)
        if done:
            # A started or finished picture can be wiped and begun again.
            reset = Gtk.Button(label="↺  Начать заново")
            reset.get_style_context().add_class("reset")
            reset.connect("clicked", lambda _b: self.reset(pic))
            slot.pack_start(reset, False, False, 0)
        if pic["id"].startswith("wd-"):
            remove = Gtk.Button(label="✕  Убрать")
            remove.get_style_context().add_class("reset")
            remove.connect("clicked", lambda _b: self.remove(pic))
            slot.pack_start(remove, False, False, 0)
        slot.show_all()

    def make_thumb(self, pic, filled, finished, widget):
        """In the thumbnail thread: the thumbnail, then shown."""
        try:
            image = thumbnail(pic, filled, finished)
        except Exception as exc:  # a broken file must not stop the thread
            sys.stderr.write("haltia-paint: %s: %s\n" % (pic["id"], exc))
            return

        def show():
            self.thumbs[pic["id"]] = image
            widget.queue_draw()
            return False

        GLib.idle_add(show)

    def remove(self, pic):
        """Take a downloaded picture out of the gallery, with its progress."""
        if not self.confirm("Убрать «%s»\nиз раскрасок?" % pic["name"], "Убрать"):
            return
        for path in (pic["path"], progress_path(pic),
                     os.path.join(DATA, "thumbs", pic["id"] + ".png")):
            try:
                os.remove(path)
            except OSError:
                pass
        self.show_gallery(rebuild=True)

    def reset(self, pic):
        if not self.confirm("Стереть раскраску «%s»\nи начать заново?" % pic["name"], "Стереть"):
            return
        for path in (progress_path(pic), os.path.join(DATA, "thumbs", pic["id"] + ".png")):
            try:
                os.remove(path)
            except OSError:
                pass
        write_last(pic["id"])
        self.show_gallery(changed=pic["id"])

