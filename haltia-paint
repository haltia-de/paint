    except OSError:
        return False


def load_pictures():
    """The pictures there are, and the photos still to be made into one
    (their paths)."""
    found, waiting = [], []
    if os.path.isdir(BUILTIN):
        for f in sorted(os.listdir(BUILTIN)):
            if f.endswith(".svgz"):
                pic = picture_at(os.path.join(BUILTIN, f), "builtin-" + f[:-5])
                if pic:
                    found.append(pic)
    if os.path.isdir(PHOTOS):
        for f in sorted(os.listdir(PHOTOS)):
            if not f.lower().endswith((".jpg", ".jpeg", ".png")):
                continue
            path = os.path.join(PHOTOS, f)
            try:
                pic_id, cached = photo_path(path)
            except OSError:
                continue
            pic = picture_at(cached, pic_id) if os.path.exists(cached) else None
            if pic:
                pic["level"] = 9
                pic["original"] = path
                found.append(pic)
            else:
                waiting.append(path)
    if os.path.isdir(DOWNLOADED):
        known = themes()
        for f in os.listdir(DOWNLOADED):
            if f.endswith(".svgz"):
                pic = picture_at(os.path.join(DOWNLOADED, f), "wd-" + f[:-5])
                if pic:
                    pic["level"] = 8
                    pic["theme"] = known.get(wd_qid(pic), pic["theme"])
                    found.append(pic)
    heads(save=True)
    return found, waiting


def move_photos():
    """~/Раскраски of versions before 4.1 into Изображения/Раскраски,
    once, with the pictures made of its photos and their progress (a
    photo's id comes from its path). A link is left at the old place."""
    if (not os.path.isdir(OLD_PHOTOS) or os.path.islink(OLD_PHOTOS)
            or os.path.lexists(PHOTOS)):
        return
    try:
        old = {f: photo_path(os.path.join(OLD_PHOTOS, f)) for f in os.listdir(OLD_PHOTOS)
               if os.path.isfile(os.path.join(OLD_PHOTOS, f))}
        os.makedirs(PICTURES, exist_ok=True)
        shutil.move(OLD_PHOTOS, PHOTOS)
        os.symlink(PHOTOS, OLD_PHOTOS)
    except OSError as exc:
        sys.stderr.write("haltia-paint: %s: %s\n" % (OLD_PHOTOS, exc))
        return
    for f, (old_id, old_file) in old.items():
        try:
            new_id, new_file = photo_path(os.path.join(PHOTOS, f))
        except OSError:
            continue
        for a, b in ((old_file, new_file),
                     (progress_path({"id": old_id}), progress_path({"id": new_id})),
                     (os.path.join(DATA, "thumbs", old_id + ".png"),
                      os.path.join(DATA, "thumbs", new_id + ".png"))):
            try:
                if os.path.exists(a) and not os.path.exists(b):
                    os.replace(a, b)
            except OSError:
                pass


def progress_path(pic):
    return os.path.join(DATA, "progress", pic["id"] + ".json")


def progress_of(pic):
    """The progress file's contents, or {} when there is none or it is of
    another picture: one made again (or one of the old grid ones) starts
    again, its regions' fingerprint (data-sig) or their count differs."""
    try:
        with open(progress_path(pic)) as fh:
            data = json.load(fh)
        if data["count"] == pic["count"] and data.get("sig") == pic.get("sig"):
            return data
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return {}


def load_progress(pic):
    """The painted regions, as a set of their indexes."""
    try:
        return {i for i in progress_of(pic).get("filled", ()) if 0 <= i < pic["count"]}
    except TypeError:
        return set()


def load_hints(pic):
    """How many times «где?» was used on the picture (since 4.6)."""
    hints = progress_of(pic).get("hints", 0)
    return hints if isinstance(hints, int) and hints > 0 else 0


def load_order(pic, filled, regions):
    """The painted regions in the order they were painted (kept since 4.6),
    those painted before in the order of their colours, light to dark:
    for the picture painted again at its end."""
    seen = set()
    order = []
    kept = progress_of(pic).get("order", ())
    for i in kept if isinstance(kept, list) else ():
        if i in filled and i not in seen:
            seen.add(i)
            order.append(i)
    return sorted((i for i in filled if i not in seen), key=lambda i: (regions[i].n, i)) + order


def save_progress(pic, filled, hints=0, order=None):
    path = progress_path(pic)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".new"
    data = {"count": pic["count"], "sig": pic.get("sig"), "filled": sorted(filled),
            "hints": hints}
    if order is not None:
        data["order"] = order
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, path)


