[Desktop Entry]
Type=Application
Name=Colouring
Name[ru]=Раскраска
Comment=Colour by number on paintings and prints
Comment[ru]=Раскраска по номерам на известных картинах
Exec=haltia-paint %f
Icon=io.github.haltia_de.Paint
Terminal=false
Categories=GTK;Game;LogicGame;
Keywords=colouring;coloring;paint by number;раскраска;картины;по номерам;
StartupNotify=true
X-Flatpak-RenamedFrom=io.github.trudenboy.Paint.desktop;
X-B8K-Home=true
# The program buzzes its own taps (a miss does not): the shell's tap buzz
# stays off while it is in front (haltia-shell 2.8).
X-Haltia-Own-Feedback=true
X-B8K-Replaces=paint;io.github.trudenboy.Paint;
X-Haltia-Share=true
MimeType=image/jpeg;image/png;image/webp;
