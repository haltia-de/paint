# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-paint
pkgver=4.8.1
pkgrel=0
pkgdesc="Раскраска: Colour by number on paintings and prints (GTK 3)"
url="https://github.com/haltia-de/paint"
arch="noarch"
license="GPL-2.0-or-later"
# The name before ADR 0004: apk upgrade carries b8k-paint over to this.
provides="b8k-paint=$pkgver-r$pkgrel"
replaces="b8k-paint"
depends="python3 py3-gobject3 gtk+3.0 py3-haltia-kit>=2.3.0 py3-cairo py3-pillow py3-numpy py3-scipy pulseaudio-utils"
checkdepends="py3-numpy py3-scipy py3-pillow py3-cairo"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/paint/archive/v$pkgver.tar.gz"
builddir="$srcdir/paint-$pkgver"

check() {
	python3 -m py_compile haltia-paint pbn.py haltia_paint/*.py
	python3 -m unittest discover -s tests
}

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
