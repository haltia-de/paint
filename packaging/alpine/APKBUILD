pkgname=b8k-paint
pkgver=3.2.1
pkgrel=0
pkgdesc="Раскраска: Colour by number on paintings and prints (GTK 3)"
url="https://github.com/trudenboy/b8k-paint"
arch="noarch"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 py3-b8k-compat py3-cairo py3-pillow py3-numpy py3-scipy"
source="$pkgname-$pkgver.tar.gz::https://github.com/trudenboy/b8k-paint/archive/v$pkgver.tar.gz"

check() {
	python3 -m py_compile b8k-paint pbn.py
}

package() {
	sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
